@{
    ViewData["Title"] = "Admin Login";
    ViewData["HideNavbar"] = true;
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-split">

    <!-- LEFT SIDE -->
    <div class="auth-image-side"
         style="background-image: url('https://picsum.photos/seed/admin-secure-login/900/1400.jpg');">

        <div class="auth-image-overlay"></div>

        <div class="auth-image-content">
            <div class="tagline">Admin Access</div>
            <h1>Secure<br />Control Panel</h1>
            <p>Only authorized admins can access system controls and user management.</p>
        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form-side">

        <div class="auth-form-wrapper">

            <a asp-controller="Home" asp-action="Index" class="brand-name">Swapster Admin</a>

            <h2 class="form-heading">Admin Login</h2>
            <p class="form-subtitle">Enter admin credentials to continue.</p>

            <form asp-action="AdminLogin" method="post">

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control"
                           placeholder="admin@example.com" required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control"
                           placeholder="Enter password" required />
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                <button type="submit" class="auth-btn-primary">
                    LOGIN AS ADMIN
                </button>

            </form>

            <div class="back-to-login">
                <a asp-action="Login" class="auth-link">
                    ← Back to User Login
                </a>
            </div>

        </div>

    </div>

</div>