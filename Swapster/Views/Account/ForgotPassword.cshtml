@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Forgot Password";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-split">

    <!-- LEFT SIDE -->
    <div class="auth-image-side"
         style="background-image: url('https://picsum.photos/seed/swapster-forgot-keys/900/1400.jpg');">

        <div class="auth-image-overlay"></div>

        <div class="auth-image-content">
            <div class="tagline">Reset Password</div>
            <h1>Don't worry,<br />it happens.</h1>
            <p>Enter your email and we'll send you a link to reset your password.</p>
        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form-side">

        <div class="auth-form-wrapper">

            <a asp-controller="Home" asp-action="Index" class="brand-name">Swapster</a>

            <h2 class="form-heading">Forgot Password?</h2>
            <p class="form-subtitle">No worries! Enter your email to get a reset link.</p>

            <form asp-action="ForgotPassword" method="post">

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" class="form-control"
                           placeholder="you@example.com" required />
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                @if (ViewBag.Message != null)
                {
                    <div class="auth-success">@ViewBag.Message</div>
                }

                <button type="submit" class="auth-btn-primary">
                    SEND RESET LINK
                </button>

            </form>

            <div class="back-to-login">
                <a asp-action="Login" class="auth-link">
                    ← Back to Login
                </a>
            </div>

        </div>

    </div>

</div>