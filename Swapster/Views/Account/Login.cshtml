@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Login";
}

<div class="container mt-5" style="max-width:400px;">
    <h2 class="text-center">Login</h2>

    <form asp-action="Login" method="post">

        <div class="mb-3">
            <label>Email</label>
            <input type="email" name="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>

        <div class="mb-3 text-end">
            <a asp-action="ForgotPassword">Forgot Password?</a>
        </div>

        <div class="text-danger mb-3">@ViewBag.Error</div>

        <!-- ✅ NORMAL LOGIN -->
        <button class="btn btn-primary w-100 mb-2">Login</button>

        <!-- ✅ ADMIN LOGIN BUTTON -->
        <a asp-action="AdminLogin" class="btn btn-dark w-100">Login as Admin</a>

        <div class="mt-3 text-center">
            <a asp-action="Signup">Don't have an account? Sign up</a>
        </div>

    </form>
</div>