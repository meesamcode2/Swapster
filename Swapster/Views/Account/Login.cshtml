@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-split">

    <!-- LEFT SIDE -->
    <div class="auth-image-side"
         style="background-image: url('https://picsum.photos/seed/swapster-laptop-study/900/1400.jpg');">

        <div class="auth-image-overlay"></div>

        <div class="auth-image-content">
            <div class="tagline">Welcome Back</div>
            <h1>Your skills<br />are waiting.</h1>
            <p>Log in to continue swapping skills and growing with the community.</p>
        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form-side">

        <div class="auth-form-wrapper">

            <a asp-controller="Home" asp-action="Index" class="brand-name">Swapster</a>

            <h2 class="form-heading">Log in</h2>
            <p class="form-subtitle">Welcome back! Enter your credentials.</p>

            <form asp-action="Login" method="post">

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control"
                           placeholder="you@example.com" required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control"
                           placeholder="Enter your password" required />
                </div>

                <div class="forgot-link">
                    <a asp-action="ForgotPassword" class="auth-link" style="font-size:0.82rem;">
                        Forgot Password?
                    </a>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                <button type="submit" class="auth-btn-primary">LOGIN</button>

                <div class="auth-divider">
                    <span>or continue with</span>
                </div>

                <div class="social-btns">
                    <a href="#" class="social-btn">Google</a>
                    <a href="#" class="social-btn">Facebook</a>
                    <a href="#" class="social-btn">Apple</a>
                </div>

                <div style="margin-top:1.25rem;">
                    <a asp-action="AdminLogin" class="auth-btn-dark">
                        Login as Admin
                    </a>
                </div>

            </form>

            <div class="auth-footer-text">
                Don't have an account? <a asp-action="Signup" class="auth-link">Sign up</a>
            </div>

        </div>

    </div>

</div>