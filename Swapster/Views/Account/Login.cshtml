@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "auth-page";
}

<style>
    .auth-page {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
    }

    .auth-split {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.20), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.18), transparent 35%), #f6f8ff;
    }

    .auth-image-side {
        position: relative;
        overflow: hidden;
        padding: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
    }

        .auth-image-side::before {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.16);
            top: -150px;
            left: -130px;
        }

        .auth-image-side::after {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.13);
            bottom: -120px;
            right: -100px;
        }

    .auth-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(17, 24, 39, 0.20), rgba(17, 24, 39, 0.05));
        z-index: 1;
    }

    .auth-image-content {
        position: relative;
        z-index: 2;
        max-width: 520px;
        color: white;
    }

        .auth-image-content h1 {
            font-size: 56px;
            line-height: 1.05;
            font-weight: 900;
            letter-spacing: -2px;
            margin: 0 0 22px;
        }

        .auth-image-content p {
            font-size: 17px;
            line-height: 1.7;
            opacity: 0.95;
            max-width: 460px;
            margin-bottom: 34px;
        }

    .login-preview {
        display: grid;
        gap: 16px;
        max-width: 430px;
    }

    .preview-card {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
    }

    .preview-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: white;
        color: #6674ff;
        display: grid;
        place-items: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .preview-card h4 {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 800;
    }

    .preview-card p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        opacity: 0.88;
    }

    .auth-form-side {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px;
    }

    .auth-form-wrapper {
        width: 100%;
        max-width: 460px;
        background: white;
        padding: 42px;
        border-radius: 32px;
        box-shadow: 0 24px 60px rgba(35, 45, 90, 0.13);
        border: 1px solid #eef0f7;
    }

    .brand-name {
        display: inline-block;
        text-decoration: none;
        color: #111827;
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 26px;
        letter-spacing: -0.8px;
    }

        .brand-name span {
            color: #6674ff;
        }

        .brand-name:hover {
            color: #6674ff;
        }

    .form-heading {
        font-size: 34px;
        font-weight: 900;
        color: #111827;
        margin: 0 0 8px;
        letter-spacing: -1px;
    }

    .form-subtitle {
        color: #6b7280;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        height: 50px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        padding: 12px 15px;
        font-size: 15px;
        color: #111827;
        background: #f9fafb;
        transition: 0.25s;
        box-sizing: border-box;
    }

        .form-control:focus {
            background: white;
            border-color: #6674ff;
            box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.13);
            outline: none;
        }

    .forgot-link {
        text-align: right;
        margin-top: -6px;
        margin-bottom: 18px;
    }

    .auth-error {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #fecdd3;
        padding: 12px 14px;
        border-radius: 15px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .auth-btn-primary {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 18px;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 0.6px;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(102, 116, 255, 0.28);
        transition: 0.3s;
        margin-top: 5px;
    }

        .auth-btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 36px rgba(102, 116, 255, 0.35);
        }

    .auth-btn-dark {
        width: 100%;
        height: 50px;
        border-radius: 18px;
        background: #111827;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 850;
        transition: 0.3s;
        box-shadow: 0 12px 25px rgba(17, 24, 39, 0.18);
    }

        .auth-btn-dark:hover {
            color: white;
            transform: translateY(-3px);
            background: #1f2937;
        }

    .auth-footer-text {
        margin-top: 26px;
        text-align: center;
        color: #6b7280;
        font-size: 15px;
    }

    .auth-link {
        color: #6674ff;
        font-weight: 800;
        text-decoration: none;
    }

        .auth-link:hover {
            color: #ff64aa;
        }

    @@media (max-width: 992px) {
        .auth-split {
            grid-template-columns: 1fr;
        }

        .auth-image-side {
            min-height: 420px;
            padding: 45px 30px;
        }

        .auth-image-content h1 {
            font-size: 42px;
        }
    }

    @@media (max-width: 576px) {
        .auth-form-side {
            padding: 24px;
        }

        .auth-form-wrapper {
            padding: 28px 22px;
            border-radius: 24px;
        }

        .form-heading {
            font-size: 28px;
        }

        .auth-image-content h1 {
            font-size: 34px;
        }
    }
</style>

<div class="auth-split">
    <div class="auth-image-side">
        <div class="auth-image-overlay"></div>
        <div class="auth-image-content">
            <h1>Your skills<br />are waiting.</h1>
            <p>Log in to continue swapping skills, finding compatible learners, and growing with the Swapster community.</p>
            <div class="login-preview">
                <div class="preview-card">
                    <div class="preview-icon">🔍</div>
                    <div><h4>Explore Skills</h4><p>Find people sharing skills you want to learn.</p></div>
                </div>
                <div class="preview-card">
                    <div class="preview-icon">🤝</div>
                    <div><h4>Continue Swapping</h4><p>Send requests and connect with compatible users.</p></div>
                </div>
                <div class="preview-card">
                    <div class="preview-icon">💡</div>
                    <div><h4>AI Skill Help</h4><p>Use Swapster assistant to get learning guidance.</p></div>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-form-side">
        <div class="auth-form-wrapper">
            <a asp-controller="Home" asp-action="Index" class="brand-name">Swap<span>ster</span></a>
            <h2 class="form-heading">Log in</h2>
            <p class="form-subtitle">Welcome back! Enter your credentials to continue.</p>

            <form asp-action="Login" method="post">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                </div>
                <div class="forgot-link">
                    <a asp-action="ForgotPassword" class="auth-link">Forgot Password?</a>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error?.ToString()))
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                <button type="submit" class="auth-btn-primary">LOGIN</button>
                <div style="margin-top: 1.25rem;">
                    <a asp-action="AdminLogin" class="auth-btn-dark">Login as Admin</a>
                </div>
            </form>

            <div class="auth-footer-text">
                Don't have an account? <a asp-action="Signup" class="auth-link">Sign up</a>
            </div>
        </div>
    </div>
</div>