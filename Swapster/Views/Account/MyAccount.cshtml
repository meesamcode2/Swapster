@model Swapster.Models.MyAccountViewModel

@{
    ViewData["Title"] = "My Account";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "dashboard-page";
}

<style>
    /* Main Layout */
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .dashboard-layout {
        min-height: 100vh;
        display: flex;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.16), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.14), transparent 35%), #f6f8ff;
    }

    /* Sidebar */
    .sidebar {
        width: 260px;
        min-height: 100vh;
        background: linear-gradient(180deg, #111827, #1f1f3a);
        color: white;
        padding: 26px 20px;
        position: fixed;
        left: 0;
    }

    .sidebar-brand {
        text-decoration: none;
        display: flex;
        align-items: center;
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 30px;
    }

    .brand-swap {
        color: #d9573b;
    }

    .brand-ster {
        color: #6674ff;
    }

    .sidebar-menu {
        display: grid;
        gap: 10px;
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #d1d5db;
        padding: 12px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

        .menu-link.active {
            background: linear-gradient(135deg, #6674ff, #ff64aa);
            color: white;
        }

    .logout-btn {
        width: 100%;
        margin-top: 20px;
        padding: 10px;
        border-radius: 12px;
        border: none;
        background: rgba(255,255,255,0.1);
        color: white;
        cursor: pointer;
    }

    /* Main Content */
    .main {
        margin-left: 260px;
        width: calc(100% - 260px);
        padding: 30px;
    }

    .topbar {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        padding: 20px;
        border-radius: 20px;
        margin-bottom: 25px;
    }

    .account-hero {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        padding: 30px;
        border-radius: 25px;
        margin-bottom: 25px;
    }

    .account-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .account-card {
        background: white;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .form-control {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    .primary-btn {
        background: #6674ff;
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 10px;
        cursor: pointer;
    }

    .remove-btn {
        background: #fee2e2;
        color: #b91c1c;
        border: none;
        padding: 5px 10px;
        border-radius: 8px;
        cursor: pointer;
    }

    .skill-item-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f9fafb;
        margin-top: 10px;
        border-radius: 10px;
    }

    .recommend-section {
        background: white;
        padding: 20px;
        border-radius: 20px;
        margin-top: 25px;
    }

    .recommend-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-top: 15px;
    }

    .recommend-card {
        border: 1px solid #eee;
        padding: 15px;
        border-radius: 15px;
    }
</style>

<div class="dashboard-layout">
    <aside class="sidebar">
        <a href="/Home/Dashboard" class="sidebar-brand"><span class="brand-swap">Swap</span><span class="brand-ster">ster</span></a>
        <div class="sidebar-menu">
            <a href="/Home/Dashboard" class="menu-link">📊 Dashboard</a>
            <a href="/Skill/Index" class="menu-link">🔍 Explore Skills</a>
            <a href="/Account/MyAccount" class="menu-link active">👤 My Account</a>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout-btn">Logout</button></form>
    </aside>

    <main class="main">
        <div class="topbar">
            <h2>My Account</h2>
            <p>Manage your profile and skill preferences.</p>
        </div>

        <section class="account-hero">
            <h1>Hello, @(Model.Username) 👋</h1>
            <p>Add skills you can teach and skills you want to learn.</p>
        </section>

        <section class="account-grid">
            <div class="account-card">
                <h3>🧑‍🏫 Skills I Can Teach</h3>
                <form asp-controller="Account" asp-action="AddMySkill" method="post" asp-antiforgery="true">
                    <input type="text" name="skillName" class="form-control" placeholder="Skill Name" required />
                    <textarea name="description" class="form-control" placeholder="Description"></textarea>
                    <button type="submit" class="primary-btn">+ Add Skill</button>
                </form>
                <div class="skill-list">
                    @if (Model.MySkills != null)
                    {
                        @foreach (var skill in Model.MySkills)
                        {
                            <div class="skill-item-box">
                                <div><b>@skill.SkillName</b><p>@skill.Description</p></div>
                                <form asp-controller="Account" asp-action="RemoveMySkill" method="post" asp-antiforgery="true">
                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                    <button type="submit" class="remove-btn">Remove</button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="account-card">
                <h3>🎯 Skills I Want To Learn</h3>
                <form asp-controller="Account" asp-action="AddWantedSkill" method="post" asp-antiforgery="true">
                    <input type="text" name="skillName" class="form-control" placeholder="Skill Name" required />
                    <button type="submit" class="primary-btn">+ Add Goal</button>
                </form>
                <div class="skill-list">
                    @if (Model.WantedSkills != null)
                    {
                        @foreach (var wanted in Model.WantedSkills)
                        {
                            <div class="skill-item-box">
                                <div><b>@wanted.SkillName</b></div>
                                <form asp-controller="Account" asp-action="RemoveWantedSkill" method="post" asp-antiforgery="true">
                                    <input type="hidden" name="wantedSkillId" value="@wanted.WantedSkillId" />
                                    <button type="submit" class="remove-btn">Remove</button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
    </main>
</div>