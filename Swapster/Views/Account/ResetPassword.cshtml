Ye `Views/Account/ResetPassword.cshtml` mein paste kar do:

```cshtml
@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true;
    ViewData["BodyClass"] = "auth-page";
}

<div class="reset-page">
    <div class="reset-card">

        <a asp-controller="Home" asp-action="Index" class="brand-name">
            Swapster
        </a>

        <h2>Reset Password</h2>
        <p class="subtitle">
            Create a new password for your Swapster account.
        </p>

        <form method="post" asp-controller="Account" asp-action="ResetPassword">

            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="form-group">
                <label>New Password</label>
                <input type="password"
                       name="newPassword"
                       class="form-control"
                       placeholder="Enter new password"
                       required />
            </div>

            <button type="submit" class="reset-btn">
                Reset Password
            </button>

        </form>

        <div class="back-link">
            <a asp-controller="Account" asp-action="Login">
                ← Back to Login
            </a>
        </div>

    </div>
</div>

<style>
    body {
        background: #f5f7fb;
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .reset-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .reset-card {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        padding: 38px;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
    }

    .brand-name {
        display: block;
        text-align: center;
        font-size: 26px;
        font-weight: 800;
        color: #ff9800;
        text-decoration: none;
        margin-bottom: 20px;
    }

    .reset-card h2 {
        text-align: center;
        font-size: 28px;
        font-weight: 800;
        color: #25264b;
        margin-bottom: 10px;
    }

    .subtitle {
        text-align: center;
        color: #777;
        font-size: 14px;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
