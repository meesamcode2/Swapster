@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true;
    ViewData["BodyClass"] = "auth-page";
}

<style>
    
</style>

<div class="reset-page">
    <div class="reset-card">
        <div class="reset-content">
            <a asp-controller="Home" asp-action="Index" class="brand-name">Swap<span>ster</span></a>
            
            <h2>Reset Password</h2>
            <p class="subtitle">Create a new password for your Swapster account.</p>

            <form method="post" asp-controller="Account" asp-action="ResetPassword" asp-antiforgery="true">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" name="newPassword" class="form-control" placeholder="Enter new password" required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm your password" required />
                </div>

                <button type="submit" class="reset-btn">RESET PASSWORD</button>
            </form>

            <div class="back-link">
                <a asp-controller="Account" asp-action="Login">← Back to Login</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple client-side check
    document.querySelector("form").onsubmit = function() {
        var p1 = document.getElementsByName("newPassword")[0].value;
        var p2 = document.getElementsByName("confirmPassword")[0].value;
        if (p1 !== p2) {
            alert("Passwords do not match!");
            return false;
        }
        return true;
    };
</script>