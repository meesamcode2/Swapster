@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true;
    ViewData["BodyClass"] = "auth-page";
}

<style>
    .auth-page {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
    }

    .reset-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.20), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.18), transparent 35%), #f6f8ff;
    }

    .reset-card {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        padding: 42px;
        border-radius: 32px;
        box-shadow: 0 24px 60px rgba(35, 45, 90, 0.13);
        border: 1px solid #eef0f7;
        position: relative;
        overflow: hidden;
    }

        .reset-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(102, 116, 255, 0.10);
            top: -70px;
            right: -70px;
        }

        .reset-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(255, 100, 170, 0.10);
            bottom: -60px;
            left: -60px;
        }

    .reset-content {
        position: relative;
        z-index: 2;
    }

    .brand-name {
        display: block;
        text-align: center;
        text-decoration: none;
        color: #111827;
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 24px;
        letter-spacing: -0.8px;
    }

        .brand-name span {
            color: #6674ff;
        }

    .reset-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 22px;
        border-radius: 22px;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        display: grid;
        place-items: center;
        font-size: 32px;
        box-shadow: 0 16px 35px rgba(102, 116, 255, 0.28);
    }

    .reset-card h2 {
        text-align: center;
        font-size: 34px;
        font-weight: 900;
        color: #111827;
        margin: 0 0 10px;
        letter-spacing: -1px;
    }

    .subtitle {
        text-align: center;
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 30px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        height: 52px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        padding: 12px 15px;
        font-size: 15px;
        color: #111827;
        background: #f9fafb;
        transition: 0.25s;
        outline: none;
        box-sizing: border-box;
    }

        .form-control:focus {
            background: white;
            border-color: #6674ff;
            box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.13);
        }

    .reset-btn {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 18px;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 0.6px;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(102, 116, 255, 0.28);
        transition: 0.3s;
    }

        .reset-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 36px rgba(102, 116, 255, 0.35);
        }

    .back-link {
        text-align: center;
        margin-top: 24px;
    }

        .back-link a {
            color: #6674ff;
            text-decoration: none;
            font-weight: 800;
            font-size: 14px;
        }

            .back-link a:hover {
                color: #ff64aa;
            }

    @@media (max-width: 576px) {
        .reset-page {
            padding: 22px;
        }

        .reset-card {
            padding: 32px 24px;
            border-radius: 24px;
        }

            .reset-card h2 {
                font-size: 28px;
            }
    }
</style>

<div class="reset-page">
    <div class="reset-card">

        <div class="reset-content">

            <a asp-controller="Home" asp-action="Index" class="brand-name">
                Swap<span>ster</span>
            </a>

            <div class="reset-icon">
                🔐
            </div>

            <h2>Reset Password</h2>

            <p class="subtitle">
                Create a new password for your Swapster account.
            </p>

            <form method="post" asp-controller="Account" asp-action="ResetPassword">

                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password"
                           name="newPassword"
                           class="form-control"
                           placeholder="Enter new password"
                           required />
                </div>

                <button type="submit" class="reset-btn">
                    RESET PASSWORD
                </button>

            </form>

            <div class="back-link">
                <a asp-controller="Account" asp-action="Login">
                    ← Back to Login
                </a>
            </div>

        </div>

    </div>
</div>