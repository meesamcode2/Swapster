@model Swapster.Models.UserProfile

@{
    ViewData["Title"] = "Setup Profile";
    ViewData["HideNavbar"] = true;
    ViewData["BodyClass"] = "auth-page";
}

<style>
        .auth-page {
                margin: 0;
                font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
                background: #f6f8ff;

    }

        .auth-split {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 1fr 1fr;
                background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.20), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.18), transparent 35%), #f6f8ff;

    }


    /* LEFT SIDE */
        .auth-image-side {
                position: relative;
                overflow: hidden;
                padding: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #6674ff, #ff64aa);

    }

                .auth-image-side::before {
                        content: "";
                        position: absolute;
                        width: 520px;
                        height: 520px;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.16);
                        top: -150px;
                        left: -130px;

        }

                .auth-image-side::after {
                        content: "";
                        position: absolute;
                        width: 420px;
                        height: 420px;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.13);
                        bottom: -120px;
                        right: -100px;

        }

        .auth-image-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(17, 24, 39, 0.20), rgba(17, 24, 39, 0.05));
                z-index: 1;

    }

        .auth-image-content {
                position: relative;
                z-index: 2;
                max-width: 520px;
                color: white;

    }

        .brand-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: rgba(255, 255, 255, 0.18);
                border: 1px solid rgba(255, 255, 255, 0.35);
                backdrop-filter: blur(14px);
                padding: 10px 16px;
                border-radius: 40px;
                font-weight: 700;
                margin-bottom: 26px;

    }

        .auth-image-content h1 {
                font-size: 56px;
                line-height: 1.05;
                font-weight: 900;
                letter-spacing: -2px;
                margin: 0 0 22px;

    }

        .auth-image-content p {
                font-size: 17px;
                line-height: 1.7;
                opacity: 0.95;
                max-width: 460px;
                margin-bottom: 34px;

    }

        .profile-preview {
                display: grid;
                gap: 16px;
                max-width: 430px;

    }

        .preview-card {
                background: rgba(255, 255, 255, 0.18);
                border: 1px solid rgba(255, 255, 255, 0.35);
                backdrop-filter: blur(16px);
                border-radius: 22px;
                padding: 18px;
                display: flex;
                align-items: center;
                gap: 15px;
                box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);

    }

        .preview-icon {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                background: white;
                color: #6674ff;
                display: grid;
                place-items: center;
                font-size: 24px;
                flex-shrink: 0;

    }

        .preview-card h4 {
                margin: 0 0 4px;
                font-size: 16px;
                font-weight: 800;

    }

        .preview-card p {
                margin: 0;
                font-size: 13px;
                line-height: 1.5;
                opacity: 0.88;

    }


    /* RIGHT SIDE */
        .auth-form-side {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 45px;

    }

        .auth-form-wrapper {
                width: 100%;
                max-width: 500px;
                background: white;
                padding: 42px;
                border-radius: 32px;
                box-shadow: 0 24px 60px rgba(35, 45, 90, 0.13);
                border: 1px solid #eef0f7;

    }

        .brand-name {
                display: inline-block;
                text-decoration: none;
                color: #111827;
                font-size: 28px;
                font-weight: 900;
                margin-bottom: 24px;
                letter-spacing: -0.8px;

    }

            .brand-name span {
                    color: #6674ff;

    }

        .form-heading {
                font-size: 34px;
                font-weight: 900;
                color: #111827;
                margin: 0 0 8px;
                letter-spacing: -1px;

    }

        .form-subtitle {
                color: #6b7280;
                margin-bottom: 28px;
                line-height: 1.6;

    }

        .form-group {
                margin-bottom: 18px;

    }

            .form-group label {
                    display: block;
                    font-size: 14px;
                    font-weight: 700;
                    color: #374151;
                    margin-bottom: 8px;

    }

        .form-control {
                width: 100%;
                border-radius: 16px;
                border: 1px solid #e5e7eb;
                padding: 12px 15px;
                font-size: 15px;
                color: #111827;
                background: #f9fafb;
                transition: 0.25s;

    }

        input.form-control,
        select.form-control {
                height: 50px;

    }

        textarea.form-control {
                resize: none;
                min-height: 80px;

    }

        .form-control:focus {
                background: white;
                border-color: #6674ff;
                box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.13);
                outline: none;

    }

        .radio-group {
                display: grid;
                gap: 10px;

    }

        .form-check {
                background: #f9fafb;
                border: 1px solid #e5e7eb;
                border-radius: 16px;
                padding: 12px 14px 12px 40px;
                transition: 0.25s;

    }

            .form-check:hover {
                    background: white;
                    border-color: #6674ff;
                    box-shadow: 0 8px 20px rgba(102, 116, 255, 0.08);

    }

        .form-check-input {
                cursor: pointer;

    }

            .form-check-input:checked {
                    background-color: #6674ff;
                    border-color: #6674ff;

    }

            .form-check-input:focus {
                    box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.13);
                    border-color: #6674ff;

    }

        .form-check-label {
                color: #4b5563;
                font-size: 14px;
                line-height: 1.5;
                cursor: pointer;

    }

            .form-check-label a {
                    color: #6674ff;
                    font-weight: 800;
                    text-decoration: none;

    }

                .form-check-label a:hover {
                        color: #ff64aa;

    }

        .auth-btn-primary {
                width: 100%;
                height: 52px;
                border: none;
                border-radius: 18px;
                background: linear-gradient(135deg, #6674ff, #ff64aa);
                color: white;
                font-size: 15px;
                font-weight: 900;
                letter-spacing: 0.6px;
                cursor: pointer;
                box-shadow: 0 14px 28px rgba(102, 116, 255, 0.28);
                transition: 0.3s;
                margin-top: 5px;

    }

            .auth-btn-primary:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 18px 36px rgba(102, 116, 255, 0.35);

    }

        .auth-note {
                margin-top: 18px;
                text-align: center;
                font-size: 13px;
                color: #9ca3af;
                line-height: 1.6;

    }

        @@media (max-width: 992px) {
                .auth-split

    {
                    grid-template-columns: 1fr;

    }

            .auth-image-side {
                    min-height: 420px;
                    padding: 45px 30px;

    }

            .auth-image-content h1 {
                    font-size: 42px;

    }

            .auth-form-wrapper {
                    max-width: 620px;

    }


    }

        @@media (max-width: 576px) {
                .auth-form-side

    {
                    padding: 24px;

    }

            .auth-form-wrapper {
                    padding: 28px 22px;
                    border-radius: 24px;

    }

            .form-heading {
                    font-size: 28px;

    }

            .auth-image-content h1 {
                    font-size: 34px;

    }

            .auth-image-side {
                    padding: 35px 22px;

    }


    }
</style>

<div class="auth-split">

    <!-- LEFT SIDE -->
    <div class="auth-image-side">

        <div class="auth-image-overlay"></div>

        <div class="auth-image-content">

            

            <h1>
                Tell us about<br />
                your skills.
            </h1>

            <p>
                A complete profile helps others find you, understand your interests,
                and start swapping skills faster.
            </p>

            <div class="profile-preview">
                <div class="preview-card">
                    <div class="preview-icon">🎯</div>
                    <div>
                        <h4>Choose Your Level</h4>
                        <p>Beginner, intermediate or expert — show where you stand.</p>
                    </div>
                </div>

                <div class="preview-card">
                    <div class="preview-icon">💡</div>
                    <div>
                        <h4>Add Your Skills</h4>
                        <p>Tell others what you can teach and what you want to learn.</p>
                    </div>
                </div>

                <div class="preview-card">
                    <div class="preview-icon">🤝</div>
                    <div>
                        <h4>Find Better Matches</h4>
                        <p>Your profile helps Swapster suggest compatible users.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form-side">

        <div class="auth-form-wrapper">

            <a asp-controller="Home" asp-action="Index" class="brand-name">
                Swap<span>ster</span>
            </a>

            <h2 class="form-heading">Create Profile</h2>
            <p class="form-subtitle">
                Help others know what you can teach and what you want to learn.
            </p>

            <form asp-action="Setup" method="post">

                <div class="form-group">
                    <label>Experience Level</label>
                    <select asp-for="ExperienceLevel" class="form-control" required>
                        <option value="">Select your level</option>
                        <option>Beginner</option>
                        <option>Intermediate</option>
                        <option>Expert</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Skills I can teach</label>
                    <textarea asp-for="Skills"
                                             class="form-control"
                                             placeholder="e.g. HTML, C#, UI Design, Photography"
                                             rows="2"></textarea>
                </div>

                <div class="form-group">
                    <label>Skills I want to learn</label>
                    <input asp-for="Interests"
                                         class="form-control"
                                         placeholder="e.g. AI, Machine Learning, Video Editing" />
                </div>

                <div class="form-group">
                    <label>Short Bio</label>
                    <textarea asp-for="Bio"
                                             class="form-control"
                                             placeholder="Tell others about yourself..."
                                             rows="3"></textarea>
                </div>

                <div class="form-group">
                    <label>Preferred swap method</label>

                    <div class="radio-group">
                        <div class="form-check">
                            <input class="form-check-input"
                                                     type="radio"
                                                     name="SwapMethod"
                                                     value="Virtual/Online"
                                                     checked />

                            <label class="form-check-label">
                                Virtual / Online
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                                     type="radio"
                                                     name="SwapMethod"
                                                     value="In Person" />

                            <label class="form-check-label">
                                In Person
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input"
                                                     type="radio"
                                                     name="SwapMethod"
                                                     value="Open to both" />

                            <label class="form-check-label">
                                Open to both
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input"
                                               type="checkbox"
                                               required />

                        <label class="form-check-label">
                            I agree to the
                            <a asp-controller="Home" asp-action="Terms">Terms of Service</a>
                            and
                            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
                        </label>
                    </div>
                </div>

                <button type="submit" class="auth-btn-primary">
                    SUBMIT PROFILE
                </button>

                <div class="auth-note">
                    Your profile can help other learners discover you faster.
                </div>

            </form>

        </div>

    </div>

</div>