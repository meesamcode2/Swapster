@model Swapster.Models.User

@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Signup";
}

<div class="container mt-5" style="max-width:400px;">
    <h2 class="text-center">Sign Up</h2>

    <form asp-action="Signup" method="post">

        <div class="mb-3">
            <label>Username</label>
            <input asp-for="Username" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>

        <div class="text-danger mb-3">@ViewBag.Error</div>

        <!-- ✅ SIGNUP BUTTON -->
        <button class="btn btn-success w-100 mb-2">Sign Up</button>

        <!-- ✅ BACK TO LOGIN -->
        <div class="text-center">
            <a asp-action="Login">Already have an account? Login</a>
        </div>

    </form>
</div>