@model Swapster.Models.User

@{
    ViewData["HideNavbar"] = true;
    ViewData["Title"] = "Signup";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-split">

    <!-- LEFT SIDE -->
    <div class="auth-image-side"
         style="background-image: url('https://picsum.photos/seed/swapster-desk-work/900/1400.jpg');">

        <div class="auth-image-overlay"></div>

        <div class="auth-image-content">
            <div class="tagline">Skill Exchange Platform</div>
            <h1>Learn anything,<br />Teach everything.</h1>
            <p>Join Swapster and connect with people who want to share skills and grow together.</p>
        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form-side">

        <div class="auth-form-wrapper">

            <a asp-controller="Home" asp-action="Index" class="brand-name">Swapster</a>

            <h2 class="form-heading">Sign up now!</h2>
            <p class="form-subtitle">Create your account and start swapping skills.</p>

            <form asp-action="Signup" method="post">

                <div class="form-group">
                    <label>Username</label>
                    <input asp-for="Username" class="form-control"
                           placeholder="Choose a username" required />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" type="email" class="form-control"
                           placeholder="you@example.com" required />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" class="form-control"
                           placeholder="Create a password" required />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" class="form-control"
                           placeholder="Repeat your password" required />
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                <button type="submit" class="auth-btn-primary">SIGN UP</button>

                <div class="auth-divider">
                    <span>or continue with</span>
                </div>

                <div class="social-btns">
                    <a href="#" class="social-btn">Google</a>
                    <a href="#" class="social-btn">Facebook</a>
                    <a href="#" class="social-btn">Apple</a>
                </div>

            </form>

            <div class="auth-footer-text">
                Already have an account? <a asp-action="Login" class="auth-link">Login</a>
            </div>

        </div>

    </div>

</div>