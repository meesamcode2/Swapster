@model Swapster.Models.AdminDeleteSkillViewModel

@{
    ViewData["Title"] = "Delete Skill";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<style>
    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
    }

    .page {
        min-height: 100vh;
        padding: 45px 20px;
    }

    .delete-card {
        max-width: 560px;
        margin: auto;
        background: white;
        border: 1px solid #fecaca;
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 16px 38px rgba(127,29,29,.08);
    }

        .delete-card h1 {
            margin: 0;
            color: #b91c1c;
            font-size: 26px;
            font-weight: 900;
        }

        .delete-card p {
            color: #6b7280;
            line-height: 1.6;
        }

    .skill-name {
        background: #fef2f2;
        color: #b91c1c;
        border-radius: 13px;
        padding: 13px;
        margin-bottom: 20px;
        font-weight: 800;
    }

    label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 800;
    }

    textarea {
        width: 100%;
        min-height: 110px;
        border: 1px solid #fecaca;
        border-radius: 13px;
        padding: 13px;
        font-family: inherit;
        box-sizing: border-box;
        resize: vertical;
        outline: none;
    }

    .validation {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .delete-btn,
    .cancel-btn {
        padding: 11px 17px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }

    .delete-btn {
        border: none;
        background: #dc2626;
        color: white;
        cursor: pointer;
    }

    .cancel-btn {
        background: #f3f4f6;
        color: #374151;
    }
</style>

<div class="page">

    <div class="delete-card">

        <h1>Remove Skill</h1>

        <p>
            The skill will be soft deleted and can later be restored by the administrator.
        </p>

        <div class="skill-name">
            @Model.SkillName
        </div>

        <form asp-controller="Admin"
              asp-action="DeleteSkill"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="SkillType" />

            <input type="hidden"
                   asp-for="SkillId" />

            <input type="hidden"
                   asp-for="SkillName" />

            <label asp-for="AdminNote">
                Deletion Reason
            </label>

            <textarea asp-for="AdminNote"
                      placeholder="Example: Duplicate, spam, inappropriate content or invalid skill..."></textarea>

            <span asp-validation-for="AdminNote"
                  class="validation"></span>

            <div class="actions">

                <button type="submit"
                        class="delete-btn">
                    Remove Skill
                </button>

                <a asp-controller="Admin"
                   asp-action="SkillDetails"
                   asp-route-type="@Model.SkillType"
                   asp-route-id="@Model.SkillId"
                   class="cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>