@model Swapster.Models.AdminSkillsViewModel

@{
    ViewData["Title"] = "Skill Management";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .admin-page {
        min-height: 100vh;
        padding: 35px;
    }

    .page-header {
        max-width: 1400px;
        margin: 0 auto 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
    }

    .page-title p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .back-btn {
        background: #111827;
        color: white;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 14px;
        font-weight: 800;
    }

    .alert-success,
    .alert-error {
        max-width: 1400px;
        margin: 0 auto 18px;
        padding: 14px 16px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 750;
    }

    .alert-success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .stats-grid {
        max-width: 1400px;
        margin: 0 auto 22px;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
    }

    .stat-card,
    .filter-card,
    .section-card {
        background: white;
        border: 1px solid #eef0f7;
        box-shadow: 0 14px 32px rgba(35,45,90,.05);
    }

    .stat-card {
        padding: 19px;
        border-radius: 19px;
    }

        .stat-card strong {
            display: block;
            font-size: 26px;
            font-weight: 900;
        }

        .stat-card span {
            display: block;
            margin-top: 5px;
            color: #6b7280;
            font-size: 12px;
        }

    .filter-card {
        max-width: 1400px;
        margin: 0 auto 22px;
        padding: 18px;
        border-radius: 20px;
    }

    .filter-form {
        display: grid;
        grid-template-columns: minmax(230px, 1fr) repeat(4, 160px) auto auto;
        gap: 10px;
    }

    .filter-control {
        width: 100%;
        height: 44px;
        border: 1px solid #dfe3ea;
        border-radius: 12px;
        padding: 0 13px;
        background: #f8fafc;
        outline: none;
        font-family: inherit;
    }

    .search-btn,
    .reset-btn {
        height: 44px;
        border-radius: 12px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .search-btn {
        border: none;
        background: #6674ff;
        color: white;
        cursor: pointer;
    }

    .reset-btn {
        border: 1px solid #e5e7eb;
        background: white;
        color: #374151;
    }

    .section-card {
        max-width: 1400px;
        margin: 0 auto 24px;
        border-radius: 24px;
        padding: 22px;
        overflow-x: auto;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .section-heading h2 {
            margin: 0;
            font-size: 21px;
            font-weight: 900;
        }

    .section-count {
        background: #eef2ff;
        color: #4f46e5;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
    }

    .skills-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1150px;
    }

        .skills-table th {
            text-align: left;
            padding: 13px;
            color: #6b7280;
            font-size: 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .skills-table td {
            padding: 14px 13px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 13px;
        }

    .skill-name {
        font-weight: 850;
    }

    .description {
        max-width: 260px;
        color: #6b7280;
        line-height: 1.5;
    }

    .badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 18px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .level-badge {
        background: #eef2ff;
        color: #4f46e5;
    }

    .active-badge {
        background: #ecfdf5;
        color: #059669;
    }

    .inactive-badge {
        background: #fff7ed;
        color: #ea580c;
    }

    .deleted-badge {
        background: #fef2f2;
        color: #dc2626;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

        .action-group form {
            margin: 0;
        }

    .action-btn {
        border: none;
        border-radius: 9px;
        padding: 7px 10px;
        font-family: inherit;
        font-size: 10px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .view-btn {
        background: #111827;
        color: white;
    }

    .edit-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .status-btn {
        background: #fff7ed;
        color: #ea580c;
    }

    .delete-btn {
        background: #fef2f2;
        color: #dc2626;
    }

    .restore-btn {
        background: #ecfdf5;
        color: #059669;
    }

    .empty-state {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }

    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .filter-form {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .admin-page {
            padding: 20px 14px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats-grid,
        .filter-form {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">

    <div class="page-header">

        <div class="page-title">
            <h1>Skill Management</h1>

            <p>
                Search, review, edit and moderate skills across Swapster.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="back-btn">
            ← Dashboard
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <section class="stats-grid">

        <div class="stat-card">
            <strong>@Model.TotalOfferedSkills</strong>
            <span>Offered skills</span>
        </div>

        <div class="stat-card">
            <strong>@Model.TotalWantedSkills</strong>
            <span>Wanted skills</span>
        </div>

        <div class="stat-card">
            <strong>@Model.ActiveSkills</strong>
            <span>Active skills</span>
        </div>

        <div class="stat-card">
            <strong>@Model.InactiveSkills</strong>
            <span>Inactive skills</span>
        </div>

        <div class="stat-card">
            <strong>@Model.DeletedSkills</strong>
            <span>Deleted skills</span>
        </div>

    </section>

    <section class="filter-card">

        <form asp-controller="Admin"
              asp-action="Skills"
              method="get"
              class="filter-form">

            <input type="text"
                   name="searchTerm"
                   value="@Model.SearchTerm"
                   class="filter-control"
                   placeholder="Search skill, username or email..." />

            <select name="typeFilter"
                    class="filter-control">

                <option value="all"
                        selected="@(Model.TypeFilter == "all")">
                    All Types
                </option>

                <option value="offered"
                        selected="@(Model.TypeFilter == "offered")">
                    Offered
                </option>

                <option value="wanted"
                        selected="@(Model.TypeFilter == "wanted")">
                    Wanted
                </option>

            </select>

            <select name="levelFilter"
                    class="filter-control">

                <option value="0"
                        selected="@(Model.LevelFilter == 0)">
                    All Levels
                </option>

                @for (int level = 1; level <= 5; level++)
                {
                    <option value="@level"
                            selected="@(Model.LevelFilter == level)">
                        Level @level
                    </option>
                }

            </select>

            <select name="statusFilter"
                    class="filter-control">

                <option value="all"
                        selected="@(Model.StatusFilter == "all")">
                    All Statuses
                </option>

                <option value="active"
                        selected="@(Model.StatusFilter == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(Model.StatusFilter == "inactive")">
                    Inactive
                </option>

                <option value="deleted"
                        selected="@(Model.StatusFilter == "deleted")">
                    Deleted
                </option>

            </select>

            <select name="sortOrder"
                    class="filter-control">

                <option value="latest"
                        selected="@(Model.SortOrder == "latest")">
                    Latest First
                </option>

                <option value="oldest"
                        selected="@(Model.SortOrder == "oldest")">
                    Oldest First
                </option>

                <option value="name"
                        selected="@(Model.SortOrder == "name")">
                    Name A-Z
                </option>

            </select>

            <button type="submit"
                    class="search-btn">
                Apply
            </button>

            <a asp-controller="Admin"
               asp-action="Skills"
               class="reset-btn">
                Reset
            </a>

        </form>

    </section>

    @if (Model.TypeFilter != "wanted")
    {
        <section class="section-card">

            <div class="section-heading">
                <h2>Offered Skills</h2>

                <span class="section-count">
                    @Model.OfferedSkills.Count results
                </span>
            </div>

            @if (Model.OfferedSkills.Any())
            {
                <table class="skills-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Skill</th>
                            <th>Description</th>
                            <th>Level</th>
                            <th>Owner</th>
                            <th>Requests</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var skill in Model.OfferedSkills)
                        {
                            <tr>

                                <td>@skill.SkillId</td>

                                <td class="skill-name">
                                    @skill.SkillName
                                </td>

                                <td class="description">
                                    @(string.IsNullOrWhiteSpace(skill.Description)
                                                            ? "No description"
                                                            : skill.Description)
                    </td>

                                <td>
                                    <span class="badge level-badge">
                                        @skill.ProficiencyLevel / 5
                                    </span>
                                </td>

                                <td>
                                    <strong>@skill.Username</strong>
                                    <br />
                                    <small>@skill.Email</small>
                                </td>

                                <td>
                                    @skill.RequestCount
                                </td>

                                <td>
                        @if (skill.IsDeleted)
                                    {
                                        <span class="badge deleted-badge">
                                            Deleted
                                        </span>
                                    }
                                    else if (skill.IsActive)
                                    {
                                        <span class="badge active-badge">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge inactive-badge">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="action-group">

                                        <a asp-controller="Admin"
                                           asp-action="SkillDetails"
                                           asp-route-type="offered"
                                           asp-route-id="@skill.SkillId"
                                           class="action-btn view-btn">
                                            View
                                        </a>

                                        @if (!skill.IsDeleted)
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="EditSkill"
                                               asp-route-type="offered"
                                               asp-route-id="@skill.SkillId"
                                               class="action-btn edit-btn">
                                                Edit
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="ToggleSkillStatus"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="type"
                                                       value="offered" />

                                                <input type="hidden"
                                                       name="id"
                                                       value="@skill.SkillId" />

                                                <button type="submit"
                                                        class="action-btn status-btn">

                                                    @(skill.IsActive
                                                                                        ? "Deactivate"
                                                                                        : "Activate")

                                </button>

                                            </form>

                                            <a asp-controller="Admin"
                                               asp-action="DeleteSkill"
                                               asp-route-type="offered"
                                               asp-route-id="@skill.SkillId"
                                               class="action-btn delete-btn">
                                                Delete
                                            </a>
                                                        }
                                        else
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="RestoreSkill"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="type"
                                                       value="offered" />

                                                <input type="hidden"
                                                       name="id"
                                                       value="@skill.SkillId" />

                                                <button type="submit"
                                                        class="action-btn restore-btn">
                                                    Restore
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">
                    No offered skills matched the filters.
                </div>
            }

        </section>
    }

    @if (Model.TypeFilter != "offered")
    {
        <section class="section-card">

            <div class="section-heading">
                <h2>Wanted Skills</h2>

                <span class="section-count">
                    @Model.WantedSkills.Count results
                </span>
            </div>

            @if (Model.WantedSkills.Any())
            {
                <table class="skills-table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Skill</th>
                            <th>Desired Level</th>
                            <th>Owner</th>
                            <th>Added</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var skill in Model.WantedSkills)
                        {
                            <tr>

                                <td>@skill.WantedSkillId</td>

                                <td class="skill-name">
                                    @skill.SkillName
                                </td>

                                <td>
                                    <span class="badge level-badge">
                                        @skill.DesiredLevel / 5
                                    </span>
                                </td>

                                <td>
                                    <strong>@skill.Username</strong>
                                    <br />
                                    <small>@skill.Email</small>
                                </td>

                                <td>
                                    @skill.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (skill.IsDeleted)
                                    {
                                        <span class="badge deleted-badge">
                                            Deleted
                                        </span>
                                    }
                                    else if (skill.IsActive)
                                    {
                                        <span class="badge active-badge">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge inactive-badge">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="action-group">

                                        <a asp-controller="Admin"
                                           asp-action="SkillDetails"
                                           asp-route-type="wanted"
                                           asp-route-id="@skill.WantedSkillId"
                                           class="action-btn view-btn">
                                            View
                                        </a>

                                        @if (!skill.IsDeleted)
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="EditSkill"
                                               asp-route-type="wanted"
                                               asp-route-id="@skill.WantedSkillId"
                                               class="action-btn edit-btn">
                                                Edit
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="ToggleSkillStatus"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="type"
                                                       value="wanted" />

                                                <input type="hidden"
                                                       name="id"
                                                       value="@skill.WantedSkillId" />

                                                <button type="submit"
                                                        class="action-btn status-btn">

                                                    @(skill.IsActive
                                                                                        ? "Deactivate"
                                                                                        : "Activate")

                                </button>

                                            </form>

                                            <a asp-controller="Admin"
                                               asp-action="DeleteSkill"
                                               asp-route-type="wanted"
                                               asp-route-id="@skill.WantedSkillId"
                                               class="action-btn delete-btn">
                                                Delete
                                            </a>
                                                        }
                                        else
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="RestoreSkill"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="type"
                                                       value="wanted" />

                                                <input type="hidden"
                                                       name="id"
                                                       value="@skill.WantedSkillId" />

                                                <button type="submit"
                                                        class="action-btn restore-btn">
                                                    Restore
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">
                    No wanted skills matched the filters.
                </div>
            }

        </section>
    }

</div>