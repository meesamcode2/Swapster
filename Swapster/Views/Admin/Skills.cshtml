@model Swapster.Models.AdminSkillsViewModel

@{
    ViewData["Title"] = "Skill Management";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .admin-page {
        min-height: 100vh;
        padding: 35px;
    }

    .page-header {
        max-width: 1400px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
    }

    .page-title p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .back-btn {
        background: #111827;
        color: white;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 14px;
        font-weight: 800;
    }

    .section-card {
        max-width: 1400px;
        margin: 0 auto 25px;
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 24px;
        padding: 22px;
        box-shadow: 0 16px 35px rgba(35,45,90,.06);
        overflow-x: auto;
    }

    .section-card h2 {
        margin-top: 0;
        font-size: 22px;
        font-weight: 900;
    }

    .skills-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .skills-table th {
        text-align: left;
        padding: 14px;
        color: #6b7280;
        font-size: 13px;
        border-bottom: 1px solid #e5e7eb;
    }

    .skills-table td {
        padding: 15px 14px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .skill-name {
        font-weight: 800;
    }

    .level-badge {
        display: inline-block;
        background: #eef2ff;
        color: #4f46e5;
        padding: 6px 10px;
        border-radius: 18px;
        font-size: 12px;
        font-weight: 800;
    }

    .empty-state {
        text-align: center;
        padding: 35px;
        color: #6b7280;
    }
</style>

<div class="admin-page">

    <div class="page-header">
        <div class="page-title">
            <h1> Skill Management</h1>
            <p>Review all offered and wanted skills on Swapster.</p>
        </div>

        <a asp-controller="Home"
           asp-action="AdminDashboard"
           class="back-btn">
            ← Dashboard
        </a>
    </div>


    <!-- OFFERED SKILLS -->

    <div class="section-card">

        <h2>Offered Skills</h2>

        @if (Model.OfferedSkills.Any())
        {
            <table class="skills-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Skill</th>
                        <th>Description</th>
                        <th>Level</th>
                        <th>User</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var skill in Model.OfferedSkills)
                    {
                        <tr>

                            <td>@skill.SkillId</td>

                            <td class="skill-name">
                                @skill.SkillName
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(skill.Description)
                                                        ? "No description"
                                                        : skill.Description)
                    </td>

                            <td>
                                <span class="level-badge">
                                    @skill.ProficiencyLevel / 5
                                </span>
                            </td>

                            <td>
                                @(skill.User?.Username ?? "Unknown")
                            </td>

                            <td>
                                @(skill.User?.Email ?? "N/A")
                            </td>

                        </tr>
                                }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">
                No offered skills found.
            </div>
        }

    </div>


    <!-- WANTED SKILLS -->

    <div class="section-card">

        <h2>Wanted Skills</h2>

        @if (Model.WantedSkills.Any())
        {
            <table class="skills-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Skill</th>
                        <th>Desired Level</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Added</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var skill in Model.WantedSkills)
                    {
                        <tr>

                            <td>@skill.WantedSkillId</td>

                            <td class="skill-name">
                                @skill.SkillName
                            </td>

                            <td>
                                <span class="level-badge">
                                    @skill.DesiredLevel / 5
                                </span>
                            </td>

                            <td>
                                @(skill.User?.Username ?? "Unknown")
                            </td>

                            <td>
                                @(skill.User?.Email ?? "N/A")
                            </td>

                            <td>
                                @skill.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">
                No wanted skills found.
            </div>
        }

    </div>

</div>