@model Swapster.Models.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;

    bool isCurrentAdmin =
        Model.User.UserId == Model.CurrentAdminId;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .details-page {
        min-height: 100vh;
        padding: 34px 20px 55px;
    }

    .details-container {
        max-width: 1200px;
        margin: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 29px;
            font-weight: 900;
        }

        .page-header p {
            margin: 6px 0 0;
            color: #6b7280;
        }

    .back-btn {
        background: #111827;
        color: white;
        padding: 11px 17px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 800;
    }

        .back-btn:hover {
            background: #1f2937;
            color: white;
        }

    .alert-success,
    .alert-error {
        padding: 14px 16px;
        border-radius: 14px;
        margin-bottom: 17px;
        font-size: 13px;
        font-weight: 750;
    }

    .alert-success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .profile-card,
    .content-card {
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 22px;
        padding: 23px;
        box-shadow: 0 14px 32px rgba(35,45,90,.06);
    }

    .profile-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 22px;
        margin-bottom: 20px;
    }

    .profile-info {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .avatar {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-size: 24px;
        font-weight: 900;
        flex-shrink: 0;
    }

    .profile-info h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 900;
    }

    .profile-info p {
        margin: 5px 0 0;
        color: #6b7280;
    }

    .badges {
        display: flex;
        gap: 7px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
    }

    .admin-badge {
        background: #fdf2f8;
        color: #db2777;
    }

    .user-badge {
        background: #eef2ff;
        color: #4f46e5;
    }

    .active-badge {
        background: #ecfdf5;
        color: #059669;
    }

    .blocked-badge {
        background: #fef2f2;
        color: #dc2626;
    }

    .verification-badge {
        background: #eff6ff;
        color: #2563eb;
    }

    .profile-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

        .profile-actions form {
            margin: 0;
        }

    .action-btn {
        border: none;
        border-radius: 12px;
        padding: 10px 14px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .block-btn {
        background: #fef2f2;
        color: #dc2626;
    }

    .unblock-btn {
        background: #ecfdf5;
        color: #059669;
    }

    .role-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .current-account-note {
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 10px 25px rgba(35,45,90,.05);
    }

        .stat-card strong {
            display: block;
            font-size: 24px;
            font-weight: 900;
        }

        .stat-card span {
            display: block;
            margin-top: 5px;
            color: #6b7280;
            font-size: 12px;
        }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 20px;
    }

    .content-card h3 {
        margin: 0 0 17px;
        font-size: 19px;
        font-weight: 900;
    }

    .skill-list {
        display: grid;
        gap: 10px;
    }

    .skill-item {
        padding: 13px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #eef0f7;
    }

        .skill-item strong {
            display: block;
            font-size: 14px;
        }

        .skill-item p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 12px;
            line-height: 1.5;
        }

    .level {
        display: inline-block;
        margin-top: 7px;
        padding: 4px 8px;
        border-radius: 15px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 10px;
        font-weight: 800;
    }

    .empty-state {
        padding: 22px;
        text-align: center;
        border: 1px dashed #d1d5db;
        border-radius: 14px;
        color: #6b7280;
        font-size: 13px;
    }

    .exchange-table-wrapper {
        overflow-x: auto;
    }

    .exchange-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

        .exchange-table th {
            text-align: left;
            padding: 12px;
            color: #6b7280;
            font-size: 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .exchange-table td {
            padding: 13px 12px;
            font-size: 13px;
            border-bottom: 1px solid #f1f5f9;
        }

    .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 16px;
        font-size: 10px;
        font-weight: 800;
    }

    .status-pending {
        background: #fff7ed;
        color: #ea580c;
    }

    .status-accepted {
        background: #ecfdf5;
        color: #059669;
    }

    .status-rejected {
        background: #fef2f2;
        color: #dc2626;
    }

    .status-completed {
        background: #eef2ff;
        color: #4f46e5;
    }

    @@media (max-width: 900px) {
        .profile-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .details-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 550px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="details-page">

    <div class="details-container">

        <div class="page-header">

            <div>
                <h1>User Details</h1>
                <p>
                    Review account information, skills and exchange activity.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Users"
               class="back-btn">
                ← User Management
            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                @TempData["Error"]
            </div>
        }

        <section class="profile-card">

            <div class="profile-info">

                <div class="avatar">
                    @(string.IsNullOrWhiteSpace(Model.User.Username)
                                        ? "U"
                                        : Model.User.Username.Substring(0, 1).ToUpper())
                </div>

                <div>

                    <h2>@Model.User.Username</h2>

                    <p>
                        @Model.User.Email
                        · Joined @Model.User.CreatedAt.ToString("dd MMM yyyy")
                    </p>

                    <div class="badges">

                        @if (Model.User.AccessLevel == 1)
                        {
                            <span class="badge admin-badge">
                                Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge user-badge">
                                User
                            </span>
                        }

                        @if (Model.User.IsBlocked)
                        {
                            <span class="badge blocked-badge">
                                Blocked
                            </span>
                        }
                        else
                        {
                            <span class="badge active-badge">
                                Active
                            </span>
                        }

                        @if (Model.User.IsEmailVerified)
                        {
                            <span class="badge verification-badge">
                                Email Verified
                            </span>
                        }
                        else
                        {
                            <span class="badge blocked-badge">
                                Email Not Verified
                            </span>
                        }

                    </div>

                </div>

            </div>

            @if (!isCurrentAdmin)
            {
                <div class="profile-actions">

                    @if (Model.User.AccessLevel != 1)
                    {
                        <form asp-controller="Admin"
                              asp-action="ToggleBlock"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.User.UserId" />

                            <input type="hidden"
                                   name="returnToDetails"
                                   value="true" />

                            <button type="submit"
                                    class="action-btn @(Model.User.IsBlocked ? "unblock-btn" : "block-btn")">

                                @(Model.User.IsBlocked
                                                        ? "Unblock User"
                                                        : "Block User")

                    </button>

                        </form>
                                }

                <form asp-controller="Admin"
                      asp-action="ChangeRole"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.User.UserId" />

                    <input type="hidden"
                           name="returnToDetails"
                           value="true" />

                    <button type="submit"
                            class="action-btn role-btn">

                        @(Model.User.AccessLevel == 1
                                                ? "Change to User"
                                                : "Promote to Admin")

                    </button>

                    </form>

                </div>
                        }
            else
            {
                <span class="current-account-note">
                    This is your current administrator account.
                </span>
            }

        </section>

        <section class="stats-grid">

            <div class="stat-card">
                <strong>@Model.OfferedSkills.Count</strong>
                <span>Offered skills</span>
            </div>

            <div class="stat-card">
                <strong>@Model.WantedSkills.Count</strong>
                <span>Wanted skills</span>
            </div>

            <div class="stat-card">
                <strong>@Model.SentRequestsCount</strong>
                <span>Sent requests</span>
            </div>

            <div class="stat-card">
                <strong>@Model.ReceivedRequestsCount</strong>
                <span>Received requests</span>
            </div>

            <div class="stat-card">
                <strong>@Model.CompletedExchangesCount</strong>
                <span>Completed exchanges</span>
            </div>

        </section>

        <section class="details-grid">

            <div class="content-card">

                <h3>Skills This User Can Teach</h3>

                <div class="skill-list">

                    @if (Model.OfferedSkills != null &&
                                        Model.OfferedSkills.Any())
                    {
                        foreach (var skill in Model.OfferedSkills)
                        {
                            <div class="skill-item">

                                <strong>@skill.SkillName</strong>

                                @if (!string.IsNullOrWhiteSpace(skill.Description))
                                {
                                    <p>@skill.Description</p>
                                }

                                <span class="level">
                                    Level @skill.ProficiencyLevel
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            No offered skills found.
                        </div>
                    }

                </div>

            </div>

            <div class="content-card">

                <h3>Skills This User Wants to Learn</h3>

                <div class="skill-list">

                    @if (Model.WantedSkills != null &&
                                        Model.WantedSkills.Any())
                    {
                        foreach (var skill in Model.WantedSkills)
                        {
                            <div class="skill-item">

                                <strong>@skill.SkillName</strong>

                                <span class="level">
                                    Desired Level @skill.DesiredLevel
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            No wanted skills found.
                        </div>
                    }

                </div>

            </div>

        </section>

        <section class="content-card">

            <h3>Exchange Activity</h3>

            @if (Model.Exchanges != null &&
                        Model.Exchanges.Any())
            {
                <div class="exchange-table-wrapper">

                    <table class="exchange-table">

                        <thead>
                            <tr>
                                <th>Direction</th>
                                <th>Other User</th>
                                <th>Skill</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var exchange in Model.Exchanges)
                            {
                                bool sentByUser =
                                exchange.SenderId ==
                                Model.User.UserId;

                                string otherUsername =
                                sentByUser
                                ? exchange.Receiver?.Username ?? "Unknown"
                                : exchange.Sender?.Username ?? "Unknown";

                                string statusClass =
                                exchange.Status == "Completed"
                                ? "status-completed"
                                : exchange.Status == "Accepted"
                                ? "status-accepted"
                                : exchange.Status == "Rejected"
                                ? "status-rejected"
                                : "status-pending";

                                <tr>

                                    <td>
                                        @(sentByUser
                                                                        ? "Sent"
                                                                        : "Received")
                                                                                 </td>

                                    <td>
                                        @otherUsername
                                    </td>

                                    <td>
                                        @(exchange.Skill?.SkillName ??
                                                                        "Unknown Skill")
                                                                                    </td>

                                    <td>
                                        <span class="status @statusClass">
                                            @exchange.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(exchange.CreatedAt
                                                                        .ToLocalTime()
                                                                        .ToString("dd MMM yyyy"))
                            </td>

                                </tr>
                                                }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">
                    This user has no exchange activity.
                </div>
            }

        </section>

    </div>

</div>