@model Swapster.Models.ChatViewModel

@{
    ViewData["Title"] = "Messages";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f6f8ff;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        color: #111827;
    }

    .chat-page {
        max-width: 900px;
        margin: 0 auto;
        min-height: 100vh;
        padding: 30px;
    }

    .chat-container {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
    }

    .chat-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .chat-header h2 {
            margin: 0;
            font-size: 21px;
            font-weight: 900;
        }

    .back-link {
        text-decoration: none;
        color: #6674ff;
        font-weight: 700;
    }

    .messages-area {
        height: 520px;
        overflow-y: auto;
        padding: 22px;
        background: #f8fafc;
    }

    .message-row {
        display: flex;
        margin-bottom: 14px;
    }

        .message-row.mine {
            justify-content: flex-end;
        }

    .message-bubble {
        max-width: 70%;
        padding: 11px 15px;
        border-radius: 17px;
        line-height: 1.5;
    }

    .mine .message-bubble {
        background: #6674ff;
        color: white;
        border-bottom-right-radius: 5px;
    }

    .theirs .message-bubble {
        background: white;
        border: 1px solid #e5e7eb;
        color: #111827;
        border-bottom-left-radius: 5px;
    }

    .message-time {
        margin-top: 5px;
        font-size: 10px;
        opacity: .7;
    }

    .message-form {
        display: flex;
        gap: 10px;
        padding: 18px;
        border-top: 1px solid #e5e7eb;
    }

    .message-input {
        flex: 1;
        border: 1px solid #d1d5db;
        border-radius: 14px;
        padding: 12px 14px;
        outline: none;
    }

        .message-input:focus {
            border-color: #6674ff;
        }

    .send-btn {
        border: none;
        background: #111827;
        color: white;
        border-radius: 14px;
        padding: 0 22px;
        font-weight: 800;
        cursor: pointer;
    }
</style>

<div class="chat-page">

    <div class="chat-container">

        <div class="chat-header">

            <h2>@Model.OtherUsername</h2>

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="back-link">
                Back to Dashboard
            </a>

        </div>

        <div class="messages-area"
             id="messagesArea">

            @if (Model.Messages.Any())
            {
                foreach (var message in Model.Messages)
                {
                    bool mine =
                    message.SenderId == Model.CurrentUserId;

                    <div class="message-row @(mine ? "mine" : "theirs")">

                        <div class="message-bubble">

                            <div>
                                @message.Content
                            </div>

                            <div class="message-time">
                                @(message.SentAt.ToLocalTime().ToString("dd MMM, hh:mm tt"))
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <p style="text-align:center;color:#6b7280;">
                    No messages yet. Start the conversation.
                </p>
            }

        </div>

        <form asp-controller="Chat"
              asp-action="Send"
              method="post"
              class="message-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="receiverId"
                   value="@Model.OtherUserId" />

            <input type="text"
                   name="content"
                   class="message-input"
                   placeholder="Write a message..."
                   maxlength="2000"
                   autocomplete="off"
                   required />

            <button type="submit"
                    class="send-btn">
                Send
            </button>

        </form>

    </div>

</div>

<script>
    const messagesArea =
        document.getElementById("messagesArea");

    if (messagesArea) {
        messagesArea.scrollTop =
            messagesArea.scrollHeight;
    }
</script>