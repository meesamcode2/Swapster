@model Swapster.Models.ChatViewModel
@using Microsoft.EntityFrameworkCore
@using Swapster.Models
@inject Swapster.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "Messages";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;

    const string sharedPostPrefix =
        "[[SHARED_POST:";

    const string sharedPostSuffix =
        "]]";

    var sharedPostIds =
        new HashSet<int>();

    if (Model?.Messages != null)
    {
        foreach (var message in Model.Messages)
        {
            string messageContent =
                message.Content ?? string.Empty;

            if (messageContent.StartsWith(
                    sharedPostPrefix) &&
                messageContent.EndsWith(
                    sharedPostSuffix))
            {
                int numberLength =
                    messageContent.Length -
                    sharedPostPrefix.Length -
                    sharedPostSuffix.Length;

                if (numberLength > 0)
                {
                    string numberText =
                        messageContent.Substring(
                            sharedPostPrefix.Length,
                            numberLength
                        );

                    if (int.TryParse(
                            numberText,
                            out int sharedPostId))
                    {
                        sharedPostIds.Add(
                            sharedPostId
                        );
                    }
                }
            }
        }
    }

    Dictionary<int, Post> sharedPosts =
        new Dictionary<int, Post>();

    if (sharedPostIds.Count > 0)
    {
        sharedPosts =
            await Db.Posts
                .AsNoTracking()
                .Include(post => post.User)
                .Where(post =>
                    sharedPostIds.Contains(
                        post.PostId
                    ))
                .ToDictionaryAsync(
                    post => post.PostId
                );
    }
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #f6f8ff;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        color: #111827;
    }

    .chat-page {
        max-width: 900px;
        margin: 0 auto;
        min-height: 100vh;
        padding: 30px;
    }

    .chat-container {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
    }

    .chat-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

        .chat-header h2 {
            margin: 0;
            font-size: 21px;
            font-weight: 900;
        }

    .back-link {
        text-decoration: none;
        color: #6674ff;
        font-weight: 700;
    }

    .messages-area {
        height: 520px;
        overflow-y: auto;
        padding: 22px;
        background: #f8fafc;
    }

    .message-row {
        display: flex;
        margin-bottom: 14px;
    }

        .message-row.mine {
            justify-content: flex-end;
        }

    .message-bubble {
        max-width: 70%;
        padding: 11px 15px;
        border-radius: 17px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .mine .message-bubble {
        background: #6674ff;
        color: white;
        border-bottom-right-radius: 5px;
    }

    .theirs .message-bubble {
        background: white;
        border: 1px solid #e5e7eb;
        color: #111827;
        border-bottom-left-radius: 5px;
    }

    .message-time {
        margin-top: 5px;
        font-size: 10px;
        opacity: .72;
    }

    /* Shared post message uses a card instead of a normal text bubble. */
    .message-row.shared-post-row .message-bubble {
        width: min(430px, 78vw);
        max-width: 78%;
        padding: 0;
        overflow: hidden;
        background: white;
        color: #111827;
        border: 1px solid #e5e7eb;
        box-shadow: 0 8px 22px rgba(17, 24, 39, 0.06);
    }

    .shared-post-label {
        padding: 10px 13px;
        color: #6b7280;
        font-size: 11px;
        font-weight: 800;
        border-bottom: 1px solid #eef2f7;
        background: #fafbff;
    }

    .shared-post-body {
        padding: 13px;
    }

    .shared-post-author {
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 900;
        color: #111827;
    }

    .shared-post-content {
        color: #374151;
        font-size: 13px;
        line-height: 1.5;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .shared-post-image,
    .shared-post-video {
        display: block;
        width: 100%;
        max-height: 300px;
        margin-top: 10px;
        border-radius: 12px;
        object-fit: cover;
        background: #111827;
    }

    .shared-post-link {
        display: inline-block;
        margin-top: 11px;
        color: #6674ff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 850;
    }

    .shared-post-message-time {
        padding: 0 13px 11px;
        color: #9ca3af;
        font-size: 10px;
    }

    .shared-post-unavailable {
        padding: 14px;
        color: #6b7280;
        font-size: 13px;
    }

    .message-form {
        display: flex;
        gap: 10px;
        padding: 18px;
        border-top: 1px solid #e5e7eb;
    }

    .message-input {
        flex: 1;
        border: 1px solid #d1d5db;
        border-radius: 14px;
        padding: 12px 14px;
        outline: none;
    }

        .message-input:focus {
            border-color: #6674ff;
        }

    .send-btn {
        border: none;
        background: #111827;
        color: white;
        border-radius: 14px;
        padding: 0 22px;
        font-weight: 800;
        cursor: pointer;
    }

    @@media (max-width: 650px) {
        .chat-page {
            padding: 12px;
        }

        .messages-area {
            height: 62vh;
            padding: 14px;
        }

        .message-bubble,
        .message-row.shared-post-row .message-bubble {
            max-width: 88%;
        }

        .chat-header {
            padding: 16px;
        }

        .message-form {
            padding: 12px;
        }
    }
</style>

<div class="chat-page">

    <div class="chat-container">

        <div class="chat-header">

            <h2>@Model.OtherUsername</h2>

            <a asp-controller="Chat"
               asp-action="Index"
               class="back-link">
                Back to Messages
            </a>

        </div>

        <div class="messages-area"
             id="messagesArea">

            @if (Model.Messages.Any())
            {
                foreach (var message in Model.Messages)
                {
                    bool mine =
                    message.SenderId ==
                    Model.CurrentUserId;

                    string messageContent =
                    message.Content ??
                    string.Empty;

                    bool sharedPostMessage =
                    false;

                    int sharedPostId =
                    0;

                    if (messageContent.StartsWith(
                    sharedPostPrefix) &&
                    messageContent.EndsWith(
                    sharedPostSuffix))
                    {
                        int numberLength =
                        messageContent.Length -
                        sharedPostPrefix.Length -
                        sharedPostSuffix.Length;

                        if (numberLength > 0)
                        {
                            string numberText =
                            messageContent.Substring(
                            sharedPostPrefix.Length,
                            numberLength
                            );

                            sharedPostMessage =
                            int.TryParse(
                            numberText,
                            out sharedPostId
                            );
                        }
                    }

                    if (sharedPostMessage)
                    {
                        <div class="message-row shared-post-row @(mine ? "mine" : "theirs")">

                            <div class="message-bubble">

                                <div class="shared-post-label">
                                    Shared a post
                                </div>

                                @if (sharedPosts.TryGetValue(
                                                    sharedPostId,
                                                    out Post? sharedPost))
                                {
                                    <div class="shared-post-body">

                                        <div class="shared-post-author">
                                            @(sharedPost.User?.Username ?? "Swapster User")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                sharedPost.Content))
                                        {
                                            <div class="shared-post-content">@sharedPost.Content</div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                                                sharedPost.ImagePath))
                                        {
                                            <img src="@sharedPost.ImagePath"
                                                 class="shared-post-image"
                                                 alt="Shared post image" />
                                        }

                                        @if (!string.IsNullOrWhiteSpace(
                                                                sharedPost.VideoPath))
                                        {
                                            <video class="shared-post-video"
                                                   controls
                                                   preload="metadata">
                                                <source src="@sharedPost.VideoPath" />
                                                Your browser does not support video playback.
                                            </video>
                                        }

                                        <a asp-controller="Home"
                                           asp-action="Dashboard"
                                           asp-fragment="post-@sharedPost.PostId"
                                           class="shared-post-link">
                                            View Post →
                                        </a>

                                    </div>
                                }
                                else
                                {
                                    <div class="shared-post-unavailable">
                                        This shared post is no longer available.
                                    </div>
                                }

                                <div class="shared-post-message-time">
                                    @(message.SentAt.ToLocalTime().ToString("dd MMM, hh:mm tt"))
                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="message-row @(mine ? "mine" : "theirs")">

                            <div class="message-bubble">

                                <div>@message.Content</div>

                                <div class="message-time">
                                    @(message.SentAt.ToLocalTime().ToString("dd MMM, hh:mm tt"))
                                </div>

                            </div>

                        </div>
                    }
                }
            }
            else
            {
                <p style="text-align:center;color:#6b7280;">
                    No messages yet. Start the conversation.
                </p>
            }

        </div>

        <form asp-controller="Chat"
              asp-action="Send"
              method="post"
              class="message-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="receiverId"
                   value="@Model.OtherUserId" />

            <input type="text"
                   name="content"
                   class="message-input"
                   placeholder="Write a message..."
                   maxlength="2000"
                   autocomplete="off"
                   required />

            <button type="submit"
                    class="send-btn">
                Send
            </button>

        </form>

    </div>

</div>

<script>
    const messagesArea =
        document.getElementById(
            "messagesArea"
        );

    if (messagesArea) {
        messagesArea.scrollTop =
            messagesArea.scrollHeight;
    }
</script>
