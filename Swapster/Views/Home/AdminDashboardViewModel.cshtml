@model Swapster.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Management Console";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "admin-dashboard-page";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f4f6fb;
        color: #111827;
    }

    .dashboard-layout {
        min-height: 100vh;
        display: flex;
        background: #f4f6fb;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
        width: 250px;
        min-height: 100vh;
        background: linear-gradient(180deg, #0f172a, #1e293b);
        color: white;
        padding: 28px 20px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        overflow-y: auto;
        box-shadow: 12px 0 30px rgba(15, 23, 42, 0.14);
    }

    .sidebar-brand {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        font-size: 26px;
        font-weight: 900;
        margin-bottom: 36px;
        letter-spacing: -1px;
    }

        .sidebar-brand .brand-swap {
            color: #ff64aa;
        }

        .sidebar-brand .brand-ster {
            color: #6674ff;
        }

    .sidebar-badge {
        font-size: 10px;
        background: #475569;
        color: white;
        padding: 4px 8px;
        border-radius: 8px;
        margin-left: 8px;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: .5px;
    }

    .sidebar-menu {
        display: grid;
        gap: 8px;
    }

    .sidebar a.menu-link {
        display: flex;
        align-items: center;
        color: #cbd5e1;
        padding: 13px 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 650;
        transition: 0.2s;
    }

        .sidebar a.menu-link:hover,
        .sidebar a.active {
            background: rgba(255,255,255,0.10);
            color: white;
            transform: translateX(3px);
        }

    .logout-form {
        margin-top: 32px;
    }

    .logout-btn {
        width: 100%;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        color: white;
        padding: 12px 14px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
    }

        .logout-btn:hover {
            background: rgba(239,68,68,0.18);
            border-color: rgba(239,68,68,0.45);
        }

    /* ================= MAIN ================= */

    .main {
        margin-left: 250px;
        width: calc(100% - 250px);
        padding: 32px;
    }

    .topbar {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 28px rgba(15,23,42,0.05);
        margin-bottom: 28px;
    }

    .topbar-title h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 900;
    }

    .topbar-title p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .system-status {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        background: #ecfdf5;
        color: #047857;
        padding: 9px 14px;
        border-radius: 20px;
    }

    .status-pulse {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
    }

    /* ================= STATS ================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: white;
        padding: 22px;
        border-radius: 18px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 28px rgba(15,23,42,0.05);
        min-height: 145px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .stat-label {
        font-size: 12px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 10px;
    }

    .stat-card h3 {
        margin: 0;
        font-size: 31px;
        font-weight: 900;
        color: #111827;
    }

    .stat-card p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.5;
    }

    /* ================= ACTIONS ================= */

    .quick-actions-panel {
        background: white;
        border-radius: 20px;
        border: 1px solid #e5e7eb;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(15,23,42,0.05);
    }

    .panel-header {
        margin-bottom: 20px;
    }

        .panel-header h3 {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 900;
        }

        .panel-header p {
            margin: 0;
            font-size: 14px;
            color: #6b7280;
        }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .action-route-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 170px;
        padding: 20px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        border-radius: 16px;
        text-decoration: none;
        color: inherit;
        transition: 0.2s;
    }

        .action-route-card:hover {
            transform: translateY(-3px);
            background: white;
            border-color: #6674ff;
            box-shadow: 0 10px 24px rgba(102,116,255,0.10);
        }

    .card-meta h4 {
        margin: 0 0 8px;
        font-size: 17px;
        font-weight: 850;
        color: #111827;
    }

    .card-meta p {
        margin: 0;
        font-size: 13px;
        color: #6b7280;
        line-height: 1.6;
    }

    .card-arrow {
        margin-top: 16px;
        font-weight: 800;
        color: #6674ff;
        font-size: 13px;
    }

    @@media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-layout {
            display: block;
        }

        .sidebar {
            position: relative;
            width: 100%;
            min-height: auto;
        }

        .main {
            width: 100%;
            margin-left: 0;
            padding: 18px;
        }

        .topbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-layout">

    <aside class="sidebar">

        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-brand">

            <span class="brand-swap">Swap</span>
            <span class="brand-ster">ster</span>

            <span class="sidebar-badge">
                Admin
            </span>

        </a>

        <div class="sidebar-menu">

            <a asp-controller="Home"
               asp-action="AdminDashboard"
               class="menu-link active">
                Dashboard
            </a>

            <a asp-controller="Admin"
               asp-action="Users"
               class="menu-link">
                User Management
            </a>

            <a asp-controller="Admin"
               asp-action="Skills"
               class="menu-link">
                Skill Management
            </a>

            <a asp-controller="Admin"
               asp-action="Exchanges"
               class="menu-link">
                Exchange Management
            </a>

        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="logout-form">

            <button type="submit"
                    class="logout-btn">
                Sign Out
            </button>

        </form>

    </aside>


    <main class="main">

        <div class="topbar">

            <div class="topbar-title">

                <h2>Admin Dashboard</h2>

                <p>
                    Welcome back,
                    @(Model?.AdminName ?? "Administrator").
                    Monitor Swapster platform activity.
                </p>

            </div>

            <div class="system-status">

                <div class="status-pulse"></div>

                System Operational

            </div>

        </div>


        <section class="stats-grid">

            <div class="stat-card">

                <div class="stat-label">
                    Users
                </div>

                <h3>
                    @Model?.TotalUsers
                </h3>

                <p>
                    Total registered accounts
                </p>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Skills
                </div>

                <h3>
                    @Model?.TotalSkills
                </h3>

                <p>
                    Total offered skills
                </p>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Active Exchanges
                </div>

                <h3>
                    @Model?.ActiveSwaps
                </h3>

                <p>
                    Accepted exchanges currently in progress
                </p>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Completed Exchanges
                </div>

                <h3>
                    @Model?.CompletedSwaps
                </h3>

                <p>
                    Exchanges confirmed complete by both users
                </p>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Pending Requests
                </div>

                <h3>
                    @Model?.PendingRequests
                </h3>

                <p>
                    Exchange requests awaiting response
                </p>

            </div>

        </section>


        <section class="quick-actions-panel">

            <div class="panel-header">

                <h3>
                    Management Sections
                </h3>

                <p>
                    Access the main administrative areas of the Swapster platform.
                </p>

            </div>


            <div class="actions-grid">

                <a asp-controller="Admin"
                   asp-action="Users"
                   class="action-route-card">

                    <div class="card-meta">

                        <h4>
                            User Management
                        </h4>

                        <p>
                            Review registered users, account information
                            and access levels.
                        </p>

                    </div>

                    <div class="card-arrow">
                        Open User Management →
                    </div>

                </a>


                <a asp-controller="Admin"
                   asp-action="Skills"
                   class="action-route-card">

                    <div class="card-meta">

                        <h4>
                            Skill Management
                        </h4>

                        <p>
                            Review offered and wanted skills,
                            proficiency levels and associated users.
                        </p>

                    </div>

                    <div class="card-arrow">
                        Open Skill Management →
                    </div>

                </a>


                <a asp-controller="Admin"
                   asp-action="Exchanges"
                   class="action-route-card">

                    <div class="card-meta">

                        <h4>
                            Exchange Management
                        </h4>

                        <p>
                            Monitor pending, active, rejected and completed
                            skill exchanges.
                        </p>

                    </div>

                    <div class="card-arrow">
                        Open Exchange Management →
                    </div>

                </a>

            </div>

        </section>

    </main>

</div>