        font-size: 26px;
        cursor: pointer;
        z-index: 9999;
        box-shadow: 0 12px 28px rgba(102, 116, 255, 0.35);
    }

    #chatBox {
        position: fixed;
        bottom: 95px;
        right: 22px;
        width: 350px;
        height: 480px;
        background: white;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.22);
        display: none;
        flex-direction: column;
