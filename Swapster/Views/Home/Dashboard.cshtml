</style>

<div class="dashboard-layout">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="sidebar-brand">

            <span class="brand-swap">Swap</span>
            <span class="brand-ster">ster</span>

        </a>

        <div class="sidebar-menu">

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="menu-link active">
                Home
            </a>

            <a asp-controller="Skill"
               asp-action="Index"
               class="menu-link">
                Explore Skills
            </a>

            <a asp-controller="SkillRequest"
               asp-action="MyExchanges"
               class="menu-link">
                My Exchanges
            </a>

            <a href="#recommended"
               class="menu-link">
                Recommended Skills
            </a>

            <a asp-controller="Home"
               asp-action="Settings"
               class="menu-link">
                Settings
            </a>

        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="logout-form">

            <button type="submit"
                    class="logout-btn">
                Logout
            </button>

        </form>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="main">

        <!-- TOPBAR -->

        <div class="topbar">

            <div class="topbar-title">
                <h2>Swapster</h2>
            </div>

            <div class="topbar-actions">

                <div class="search-wrapper">

                    <span class="search-icon">⌕</span>

                    <input type="text"
                           id="searchInput"
                           class="search-bar"
                           placeholder="Search skills..."
                           onkeyup="filterSkills()" />

                </div>

                <a asp-controller="Chat"
                   asp-action="Index"
                   class="message-top-btn">
                    Messages
                </a>

            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="dashboard-alert dashboard-alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="dashboard-alert dashboard-alert-error">
                @TempData["Error"]
            </div>
        }


        <!-- SMALL INTRO -->
        <!-- SOCIAL AREA -->

        <section class="social-layout">

            <!-- LEFT FEED -->

            <div class="feed-column">

                <!-- CREATE POST -->

                <div class="post-composer">

                    <div class="composer-top">

                        <div class="avatar">
                            @((Model?.UserName ?? "U").Substring(0, 1).ToUpper())
                        </div>

                        <div class="composer-user">

                            <strong>
                                @(Model?.UserName ?? "User")
                            </strong>

                            <span>
                                Share an update with your learning network
                            </span>

                        </div>

                    </div>


                    <form asp-controller="Community"
                          asp-action="Create"
                          method="post"
                          enctype="multipart/form-data"
                          onsubmit="return validateCommunityPost(this);">

                        @Html.AntiForgeryToken()

                        <textarea name="content"
                                  class="composer-input"
                                  maxlength="2000"
                                  placeholder="Start a post..."></textarea>

                        <div class="image-preview-wrap"
                             id="postImagePreviewWrap">

                            <img id="postImagePreview"
                                 class="image-preview"
                                 alt="Selected post image preview" />

                            <button type="button"
                                    class="remove-preview-btn"
                                    onclick="clearPostImage()">
                                ×
                            </button>

                        </div>

                        <div class="video-preview-wrap"
                             id="postVideoPreviewWrap">

                            <video id="postVideoPreview"
                                   class="video-preview"
                                   controls
                                   preload="metadata"></video>

                            <button type="button"
                                    class="remove-preview-btn"
                                    onclick="clearPostVideo()">
                                ×
                            </button>

                        </div>

                        <div class="composer-footer">

                            <div class="composer-media">

                                <label class="image-picker">
                                     Add Picture

                                    <input type="file"
                                           id="postImageInput"
                                           name="image"
                                           accept="image/jpeg,image/png,image/webp"
                                           onchange="previewPostImage(this)" />
                                </label>

                                 <label class="image-picker">
                                     Add Video

                                    <input type="file"
                                           id="postVideoInput"
                                           name="video"
                                           accept="video/mp4,video/webm,video/ogg"
                                           onchange="previewPostVideo(this)" />
                                </label>


                            </div>

                            <button type="submit"
                                    class="post-btn">
                                Post
                            </button>

                        </div>

                    </form>

                </div>


                <!-- POSTS -->

                <div class="feed-heading">
                    <h3>Latest Posts</h3>
                </div>


                @if (Model?.CommunityPosts != null &&
                                Model.CommunityPosts.Any())
                {
                    foreach (var post in Model.CommunityPosts)
                    {
                        bool hasLiked =
                        post.Likes.Any(like =>
                        like.UserId == currentUserId);

                        var visibleComments =
                        post.Comments
                        .Where(comment =>
                        comment.User != null &&
                        !comment.User.IsBlocked &&
                        !comment.User.IsDeactivated)
                        .OrderBy(comment =>
                        comment.CreatedAt)
                        .ToList();

                        <article class="feed-post"
                                 id="post-@post.PostId">

                            <div class="feed-user-row">

                                <div class="feed-avatar">
                                    @((post.User?.Username ?? "U").Substring(0, 1).ToUpper())
                                </div>

                                <div>

                                    <div class="feed-user-name">
                                        @(post.User?.Username ?? "Unknown User")
                                    </div>

                                    <div class="feed-time">
                                        @(post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                    </div>

                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.Content))
                            {
                                <div class="feed-content">@post.Content</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                            {
                                <img src="@post.ImagePath"
                                     class="feed-post-image"
                                     alt="Community post image" />
                            }

                            @if (!string.IsNullOrWhiteSpace(post.VideoPath))
                            {
                                <video class="feed-post-video"
                                       controls
                                       preload="metadata">
                                    <source src="@post.VideoPath" />
                                    Your browser does not support video playback.
                                </video>
                            }

                            

                            <div class="feed-actions">

                                <form asp-controller="Community"
                                      asp-action="ToggleLike"
                                      method="post"
                                      class="feed-action-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="postId"
                                           value="@post.PostId" />

                                    <button type="submit"
                                            class="feed-action @(hasLiked ? "liked" : "")">
                                        @(hasLiked ? "👍 Liked" : "👍 Like")
                                    </button>

                                </form>

                                <button type="button"
                                        class="feed-action"
                                        onclick="toggleComments(@post.PostId)">
                                    💬 Comment
                                </button>

                                <form id="share-form-@post.PostId"
                                      class="feed-action-form">

                                    @Html.AntiForgeryToken()

                                    <button type="button"
                                            class="feed-action"
                                            onclick="openShareModal(@post.PostId)">
                                        ↗ Share
                                    </button>

                                </form>

                            </div>

                            <div class="comments-panel"
                                 id="comments-@post.PostId">

                                <form asp-controller="Community"
                                      asp-action="AddComment"
                                      method="post"
                                      class="comment-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="postId"
                                           value="@post.PostId" />

                                    <input type="text"
                                           name="comment"
                                           maxlength="1000"
                                           class="comment-input"
                                           placeholder="Write a comment..."
                                           required />

                                    <button type="submit"
                                            class="comment-submit">
                                        Comment
                                    </button>

                                </form>

                                @if (visibleComments.Any())
                                {
                                    foreach (var comment in visibleComments)
                                    {
                                        <div class="comment-item">

                                            <div class="comment-meta">

                                                <span class="comment-user">
                                                    @(comment.User?.Username ?? "User")
                                                </span>

                                                <span class="comment-time">
                                                    @(comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                                </span>

                                            </div>

                                            <div class="comment-text">@comment.Content</div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="comment-text">
                                        No comments yet.
                                    </div>
                                }

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="feed-empty">

                        <h4>No posts yet</h4>

                        <p>
                            Be the first person to share something with the Swapster community.
                        </p>

                    </div>
                }

            </div>


            <!-- RIGHT SIDE -->

            <aside class="right-column">

                <!-- PROFILE CARD -->

                <div class="side-card">

                    <div class="profile-summary">

                        <div class="profile-large-avatar">
                            @((Model?.UserName ?? "U").Substring(0, 1).ToUpper())
                        </div>

                        <h3>
                            @(Model?.UserName ?? "User")
                        </h3>

                        <p>
                            Swapster Member
                        </p>

                    </div>


                    <div class="side-divider"></div>


                    <a asp-controller="Account"
                       asp-action="MyAccount"
                       class="side-link">
                        View Profile
                    </a>

                    <a asp-controller="Chat"
                       asp-action="Index"
                       class="side-link">
                        Open Messages
                    </a>

                </div>


            </aside>

        </section>


        <!-- ================= RECOMMENDED SKILLS ================= -->

        <section class="skills-section"
                 id="recommended">

            <div class="section-header">

                <div>
                    <h3>Recommended Skills</h3>

                    <p>
                        Personalized skill matches based on what you want to learn.
                    </p>
                </div>

                <a asp-controller="Skill"
                   asp-action="Index"
                   class="view-all">
                    View All →
                </a>

            </div>


            <div class="skills-grid"
                 id="skillsContainer">

                @if (Model?.RecommendedSkills != null &&
                                Model.RecommendedSkills.Any())
                {
                    foreach (var r in Model.RecommendedSkills.Take(6))
                    {
                        <div class="skill-item">

                            <div class="skill-card">

                                <div class="match-badge">
                                    Best Match
                                </div>

                                <div class="skill-card-icon">
                                    💡
                                </div>

                                <div class="skill-title skill-name">
                                    @r.SkillName
                                </div>


                                <div class="rating-container">

                                    <span class="stars">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= r.ProficiencyLevel)
                                            {
                                                <text>★</text>
                                            }
                                            else
                                            {
                                                <text>☆</text>
                                            }
                                        }

                            </span>

                            <span class="rating-text">
                                Level @r.ProficiencyLevel/5
                            </span>

                        </div>


                        <p class="skill-description">

                            @(string.IsNullOrWhiteSpace(r.Description)
                                                        ? "No description available."
                                                        : r.Description)

                        </p>


                                <div class="owner">
                                    Instructor:
                                    @(r.User?.Username ?? "Swapster User")
                                </div>


                                <div class="skill-actions">

                                    <form asp-controller="SkillRequest"
                                          asp-action="Send"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="skillId"
                                               value="@r.SkillId" />

                                        <input type="hidden"
                                               name="receiverId"
                                               value="@r.UserId" />

                                        <button type="submit"
                                                class="request-btn">
                                            Send Swap Request
                                        </button>

                                    </form>


                                    <a asp-controller="Chat"
                                       asp-action="Conversation"
                                       asp-route-userId="@r.UserId"
                                       class="message-btn">
                                        Message
                                    </a>

                                </div>

                            </div>

                        </div>
                                }
                }
                else
                {
                    <div class="empty-state">

                        <h4>No recommended skills yet</h4>

                        <p>
                            Add skills you want to learn to receive better recommendations.
                        </p>

                    </div>
                }

            </div>

        </section>

    </main>

</div>


