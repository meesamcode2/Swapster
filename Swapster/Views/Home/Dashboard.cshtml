<!-- ================= SCRIPTS ================= -->

<script>

    function previewPostImage(input) {

        const file =
            input.files && input.files[0];

        const wrap =
            document.getElementById(
                "postImagePreviewWrap"
            );

        const preview =
            document.getElementById(
                "postImagePreview"
            );

        if (!file) {
            clearPostImage();
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("Image size cannot exceed 5 MB.");
            clearPostImage();
            return;
        }

        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];

        if (!allowedTypes.includes(file.type)) {
            alert("Only JPG, PNG and WEBP images are allowed.");
            clearPostImage();
            return;
        }

        preview.src =
            URL.createObjectURL(file);

        wrap.style.display =
            "block";
    }


    function clearPostImage() {

        const input =
            document.getElementById(
                "postImageInput"
            );

        const wrap =
            document.getElementById(
                "postImagePreviewWrap"
            );

        const preview =
            document.getElementById(
                "postImagePreview"
            );

        if (input) {
            input.value = "";
        }

        if (preview) {
            preview.removeAttribute("src");
        }

        if (wrap) {
            wrap.style.display = "none";
        }
    }


    function previewPostVideo(input) {

        const file =
            input.files && input.files[0];

        const wrap =
            document.getElementById(
                "postVideoPreviewWrap"
            );

        const preview =
            document.getElementById(
                "postVideoPreview"
            );

        if (!file) {
            clearPostVideo();
            return;
        }

        if (file.size > 50 * 1024 * 1024) {
            alert("Video size cannot exceed 50 MB.");
            clearPostVideo();
            return;
        }

        const allowedTypes = [
            "video/mp4",
            "video/webm",
            "video/ogg"
        ];

        if (!allowedTypes.includes(file.type)) {
            alert("Only MP4, WEBM and OGG videos are allowed.");
            clearPostVideo();
            return;
        }

        preview.src =
            URL.createObjectURL(file);

        wrap.style.display =
            "block";

        preview.load();
    }


    function clearPostVideo() {

        const input =
            document.getElementById(
                "postVideoInput"
            );

        const wrap =
            document.getElementById(
                "postVideoPreviewWrap"
            );

        const preview =
            document.getElementById(
                "postVideoPreview"
            );

        if (input) {
            input.value = "";
        }

        if (preview) {
            preview.pause();
            preview.removeAttribute("src");
            preview.load();
        }

        if (wrap) {
            wrap.style.display = "none";
        }
    }


    function validateCommunityPost(form) {

        const text =
            form.querySelector(
                'textarea[name="content"]'
            ).value.trim();

        const imageInput =
            form.querySelector(
                'input[name="image"]'
            );

        const videoInput =
            form.querySelector(
                'input[name="video"]'
            );

        const hasImage =
            imageInput.files &&
            imageInput.files.length > 0;

        const hasVideo =
            videoInput.files &&
            videoInput.files.length > 0;

        if (!text &&
            !hasImage &&
            !hasVideo) {
            alert(
                "Write something or choose an image/video before posting."
            );

            return false;
        }

        return true;
    }


    function toggleComments(postId) {

        const panel =
            document.getElementById(
                "comments-" + postId
            );

        if (!panel) {
            return;
        }

        panel.classList.toggle(
            "open"
        );

        if (panel.classList.contains(
                "open"
            )) {
            const input =
                panel.querySelector(
                    ".comment-input"
                );

            if (input) {
                input.focus();
            }
        }
    }

    let currentSharePostId = null;


    async function openShareModal(postId) {

        currentSharePostId = postId;

        const modal =
            document.getElementById(
                "shareModal"
            );

        const list =
            document.getElementById(
                "shareRecipientList"
            );

        if (!modal || !list) {
            return;
        }

        modal.classList.add("open");

        document.body.style.overflow =
            "hidden";

        list.innerHTML = "";

        const loading =
            document.createElement("div");

        loading.className =
            "share-loading";

        loading.textContent =
            "Loading conversations...";

        list.appendChild(loading);

        try {

            const response =
                await fetch(
                    "/PostShare/Recipients?postId=" +
                    encodeURIComponent(postId),
                    {
                        method: "GET",
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );

            if (!response.ok) {
                throw new Error(
                    "Could not load conversations."
                );
            }

            const data =
                await response.json();

            list.innerHTML = "";

            const recipients =
                Array.isArray(data?.recipients)
                    ? data.recipients
                    : [];

            if (recipients.length === 0) {

                const empty =
                    document.createElement(
                        "div"
                    );

                empty.className =
                    "share-empty";

                empty.textContent =
                    "No existing conversations found. Start a chat first, then you can share posts here.";

                const link =
                    document.createElement(
                        "a"
                    );

                link.href =
                    "/Chat";

                link.className =
                    "share-open-messages";

                link.textContent =
                    "Open Messages";

                empty.appendChild(
                    document.createElement("br")
                );

                empty.appendChild(link);

                list.appendChild(empty);

                return;
            }

            recipients.forEach(
                recipient => {

                    const row =
                        document.createElement(
                            "div"
                        );

                    row.className =
                        "share-recipient";

                    const avatar =
                        document.createElement(
                            "div"
                        );

                    avatar.className =
                        "share-recipient-avatar";

                    const username =
                        recipient?.username ||
                        "User";

                    avatar.textContent =
                        username
                            .substring(0, 1)
                            .toUpperCase();

                    const name =
                        document.createElement(
                            "div"
                        );

                    name.className =
                        "share-recipient-name";

                    name.textContent =
                        username;

                    const button =
                        document.createElement(
                            "button"
                        );

                    button.type =
                        "button";

                    button.className =
                        "share-send-btn";

                    button.textContent =
                        "Send";

                    button.addEventListener(
                        "click",
                        () =>
                            sharePostToUser(
                                recipient.userId,
                                button
                            )
                    );

                    row.appendChild(avatar);
                    row.appendChild(name);
                    row.appendChild(button);

                    list.appendChild(row);
                }
            );
        }
        catch (error) {

            console.error(
                "Share recipients error:",
                error
            );

            list.innerHTML = "";

            const errorBox =
                document.createElement(
                    "div"
                );

            errorBox.className =
                "share-error";

            errorBox.textContent =
                "Conversations could not be loaded. Please try again.";

            list.appendChild(errorBox);
        }
    }


    function closeShareModal() {

        const modal =
            document.getElementById(
                "shareModal"
            );

        if (modal) {
            modal.classList.remove(
                "open"
            );
        }

        document.body.style.overflow =
            "";

        currentSharePostId = null;
    }


    function handleShareBackdrop(event) {

        if (event.target?.id ===
            "shareModal") {
            closeShareModal();
        }
    }


    async function sharePostToUser(
        receiverId,
        button
    ) {

        if (!currentSharePostId ||
            !receiverId ||
            !button) {
            return;
        }

        const form =
            document.getElementById(
                "share-form-" +
                currentSharePostId
            );

        const tokenInput =
            form?.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

        const originalText =
            button.textContent;

        button.disabled = true;
        button.textContent =
            "Sending...";

        try {

            const body =
                new URLSearchParams();

            body.append(
                "postId",
                currentSharePostId
            );

            body.append(
                "receiverId",
                receiverId
            );

            body.append(
                "__RequestVerificationToken",
                tokenInput?.value || ""
            );

            const response =
                await fetch(
                    "/PostShare/Send",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded",
                            "X-Requested-With":
                                "XMLHttpRequest"
                        },
                        body:
                            body.toString()
                    }
                );

            const data =
                await response.json();

            if (!response.ok ||
                data?.success !== true) {

                throw new Error(
                    data?.message ||
                    "Post could not be shared."
                );
            }

            button.textContent =
                "Sent";

            const countElement =
                document.getElementById(
                    "share-count-" +
                    currentSharePostId
                );

            if (countElement &&
                data?.shareCount !== undefined) {

                countElement.textContent =
                    "↗ " +
                    data.shareCount;
            }

            const status =
                document.getElementById(
                    "share-status-" +
                    currentSharePostId
                );

            if (status) {
                status.textContent =
                    "Shared in Messages";
            }
        }
        catch (error) {

            console.error(
                "Share to chat error:",
                error
            );

            button.disabled = false;

            button.textContent =
                originalText || "Send";

            alert(
                error?.message ||
                "Post could not be shared."
            );
        }
    }


    function filterSkills() {

        let input =
            document.getElementById("searchInput")
                .value
                .toLowerCase();

        let items =
            document.getElementsByClassName("skill-item");

        for (let i = 0; i < items.length; i++) {

            let nameElement =
                items[i].getElementsByClassName("skill-name")[0];

            if (!nameElement)
                continue;

            let name =
                nameElement.innerText.toLowerCase();

            if (name.includes(input)) {
                items[i].classList.remove("hidden");
            }
            else {
                items[i].classList.add("hidden");
            }
        }
    }


    function toggleChat() {

        let box =
            document.getElementById("chatBox");

        box.style.display =
            box.style.display === "flex"
                ? "none"
                : "flex";
    }


    function escapeHtml(text) {

        if (!text)
            return "";

        return text
            .toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }


    function sendMessage() {

        let input =
            document.getElementById("chatInput");

        let msg =
            input.value.trim();

        if (msg === "")
            return;


        let chatMessages =
            document.getElementById("chatMessages");


        chatMessages.innerHTML += `
            <div class="user-msg">
                <b>You:</b> ${escapeHtml(msg)}
            </div>
        `;


        let thinkingId =
            "thinking-" + Date.now();


        chatMessages.innerHTML += `
            <div class="bot-msg" id="${thinkingId}">
                <div>
                    <b>Swapster:</b>
                    <span class="thinking-text">
                        Thinking...
                    </span>
                </div>
            </div>
        `;


        chatMessages.scrollTop =
            chatMessages.scrollHeight;


        fetch('/Home/Chat', {

            method: 'POST',

            headers: {
                'Content-Type':
                    'application/x-www-form-urlencoded'
            },

            body:
                'message=' +
                encodeURIComponent(msg)

        })

        .then(res => res.json())

        .then(data => {

            let response;

            try {

                response =
                    typeof data === "string"
                        ? JSON.parse(data)
                        : data;

            }
            catch {

                response = data;
            }


            let answer =
                response?.answer ||
                "No answer found";


            let botHtml = `
                <div class="bot-msg" id="${thinkingId}">

                    <div>
                        <b>Swapster:</b>
                        ${escapeHtml(answer)}
                    </div>
            `;


            if (response?.category) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Category:</b>
                        ${escapeHtml(response.category)}

                    </div>
                `;
            }


            if (response?.level) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Level:</b>
                        ${escapeHtml(response.level)}

                    </div>
                `;
            }


            if (response?.skills &&
                response.skills.length > 0) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Skills:</b>

                        ${response.skills
                            .map(escapeHtml)
                            .join(", ")}

                    </div>
                `;
            }


            if (response?.tools &&
                response.tools.length > 0) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Tools:</b>

                        ${response.tools
                            .map(escapeHtml)
                            .join(", ")}

                    </div>
                `;
            }


            if (response?.roadmap &&
                response.roadmap.length > 0) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Roadmap:</b>

                        <ol>
                `;


                response.roadmap.forEach(step => {

                    botHtml += `
                        <li>
                            ${escapeHtml(step)}
                        </li>
                    `;
                });


                botHtml += `
                        </ol>

                    </div>
                `;
            }


            if (response?.projects &&
                response.projects.length > 0) {

                botHtml += `
                    <div class="bot-detail">

                        <b>Projects:</b>

                        <ul>
                `;


                response.projects.forEach(project => {

                    botHtml += `
                        <li>
                            ${escapeHtml(project)}
                        </li>
                    `;
                });


                botHtml += `
                        </ul>

                    </div>
                `;
            }


            botHtml += `</div>`;


            let thinkingElement =
                document.getElementById(thinkingId);


            if (thinkingElement) {

                thinkingElement.outerHTML =
                    botHtml;
            }
            else {

                chatMessages.innerHTML +=
                    botHtml;
            }


            chatMessages.scrollTop =
                chatMessages.scrollHeight;

        })

        .catch(error => {

            console.error(
                "Chat error:",
                error
            );


            let thinkingElement =
                document.getElementById(thinkingId);


            if (thinkingElement) {

                thinkingElement.innerHTML =
                    "<b>Swapster:</b> Chatbot se connect nahi ho pa raha.";
            }

        });


        input.value = "";
    }


    document
        .getElementById("chatInput")
        .addEventListener(
            "keypress",
            function (e) {

                if (e.key === "Enter") {
                    sendMessage();
                }

            }
        );

</script>