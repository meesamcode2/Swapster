@model Swapster.Models.DashboardViewModel
@using Microsoft.AspNetCore.Http
@using System.Linq

@{
    ViewData["Title"] = "Home";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "dashboard-page";

    int currentUserId =
        Context.Session.GetInt32("UserId") ?? 0;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f4f6fb;
        color: #111827;
    }

    .dashboard-layout {
        min-height: 100vh;
        display: flex;
        background: #f4f6fb;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
        width: 250px;
        min-height: 100vh;
        background: linear-gradient(180deg, #111827, #1f2937);
        color: white;
        padding: 26px 20px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        overflow-y: auto;
        box-shadow: 10px 0 28px rgba(17, 24, 39, 0.12);
    }

    .sidebar-brand {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        font-size: 29px;
        font-weight: 900;
        margin-bottom: 34px;
        letter-spacing: -1px;
    }

    .brand-swap {
        color: #d9573b;
    }

    .brand-ster {
        color: #6674ff;
    }

    .sidebar-menu {
        display: grid;
        gap: 7px;
    }

    .sidebar a.menu-link {
        display: flex;
        align-items: center;
        color: #cbd5e1;
        padding: 13px 14px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 650;
        transition: 0.2s;
    }

        .sidebar a.menu-link:hover,
        .sidebar a.menu-link.active {
            background: rgba(255,255,255,0.10);
            color: white;
            transform: translateX(3px);
        }

    .logout-form {
        margin-top: 28px;
    }

    .logout-btn {
        width: 100%;
        border: 1px solid rgba(255,255,255,0.13);
        background: rgba(255,255,255,0.05);
        color: white;
        padding: 12px 14px;
        border-radius: 12px;
        font-weight: 750;
        cursor: pointer;
        transition: 0.2s;
    }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.16);
        }

    /* ================= MAIN ================= */

    .main {
        margin-left: 250px;
        width: calc(100% - 250px);
        padding: 26px 30px 45px;
    }

    /* ================= TOPBAR ================= */

    .topbar {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        padding: 13px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
        margin-bottom: 20px;
    }

    .topbar-title {
        flex-shrink: 0;
    }

        .topbar-title h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.4px;
        }

    .topbar-actions {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

    .search-wrapper {
        position: relative;
        width: 100%;
        max-width: 500px;
    }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 15px;
        pointer-events: none;
    }

    .search-bar {
        width: 100%;
        height: 46px;
        border: 1px solid #dfe3ea;
        border-radius: 23px;
        background: #f8fafc;
        padding: 0 17px 0 42px;
        outline: none;
        font-size: 14px;
        color: #111827;
        transition: 0.2s;
    }

        .search-bar:focus {
            background: white;
            border-color: #6674ff;
            box-shadow: 0 0 0 3px rgba(102, 116, 255, 0.10);
        }

    .message-top-btn {
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 19px;
        border-radius: 23px;
        text-decoration: none;
        background: #111827;
        color: white;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
        transition: 0.2s;
    }

        .message-top-btn:hover {
            background: #1f2937;
            color: white;
            transform: translateY(-1px);
        }

    /* ================= INTRO ================= */

    .dashboard-intro {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 17px;
        padding: 18px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.035);
    }

        .dashboard-intro h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 850;
        }

        .dashboard-intro p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    .explore-top-btn {
        text-decoration: none;
        background: #6674ff;
        color: white;
        padding: 10px 17px;
        border-radius: 23px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
        transition: 0.2s;
    }

        .explore-top-btn:hover {
            background: #5664ef;
            color: white;
            transform: translateY(-1px);
        }

    .dashboard-alert {
        margin-bottom: 16px;
        padding: 12px 15px;
        border-radius: 13px;
        font-size: 12px;
        font-weight: 750;
    }

    .dashboard-alert-success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .dashboard-alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    /* ================= MAIN SOCIAL LAYOUT ================= */

    .social-layout {
        display: grid;
        grid-template-columns: minmax(0, 2fr) 310px;
        gap: 20px;
        align-items: start;
        margin-bottom: 32px;
    }

    .feed-column {
        min-width: 0;
    }

    /* ================= POST COMPOSER ================= */

    .post-composer {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 15px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
    }

    .composer-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .avatar,
    .feed-avatar {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-weight: 900;
        font-size: 16px;
    }

    .composer-user {
        display: flex;
        flex-direction: column;
    }

        .composer-user strong {
            font-size: 14px;
            color: #111827;
        }

        .composer-user span {
            margin-top: 2px;
            color: #6b7280;
            font-size: 12px;
        }

    .composer-input {
        width: 100%;
        min-height: 82px;
        resize: vertical;
        border: 1px solid #d1d5db;
        border-radius: 16px;
        padding: 14px 16px;
        background: white;
        font-family: inherit;
        font-size: 14px;
        color: #111827;
        outline: none;
    }

        .composer-input:focus {
            border-color: #6674ff;
            box-shadow: 0 0 0 3px rgba(102, 116, 255, 0.08);
        }

    .composer-footer {
        margin-top: 11px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .composer-media {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .image-picker {
        position: relative;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 20px;
        border: 1px solid #dfe3ea;
        background: white;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

        .image-picker input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .image-preview-wrap {
        display: none;
        margin-top: 12px;
        position: relative;
    }

    .image-preview {
        width: 100%;
        max-height: 360px;
        object-fit: cover;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
    }

    .remove-preview-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(17, 24, 39, 0.82);
        color: white;
        font-weight: 900;
        cursor: pointer;
    }

    .video-preview-wrap {
        display: none;
        margin-top: 12px;
        position: relative;
    }

    .video-preview {
        width: 100%;
        max-height: 420px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        background: #111827;
    }

    .composer-hint {
        color: #9ca3af;
        font-size: 11px;
    }

    .post-btn {
        border: none;
        background: #6674ff;
        color: white;
        border-radius: 22px;
        padding: 9px 21px;
        font-weight: 800;
        font-size: 13px;
        cursor: pointer;
        transition: 0.2s;
    }

        .post-btn:hover {
            background: #5664ef;
            transform: translateY(-1px);
        }

    /* ================= FEED ================= */

    .feed-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 21px 2px 12px;
    }

        .feed-heading h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
        }

    .feed-post {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px 18px 14px;
        margin-bottom: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.035);
    }

    .feed-user-row {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .feed-user-name {
        font-size: 14px;
        font-weight: 900;
    }

    .feed-time {
        margin-top: 2px;
        color: #9ca3af;
        font-size: 11px;
    }

    .feed-content {
        margin-top: 14px;
        color: #1f2937;
        font-size: 15px;
        line-height: 1.55;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .feed-post-image {
        width: 100%;
        max-height: 560px;
        object-fit: cover;
        display: block;
        margin-top: 14px;
        border-radius: 14px;
        border: 1px solid #eef0f7;
        background: #f8fafc;
    }

    .feed-post-video {
        width: 100%;
        max-height: 560px;
        display: block;
        margin-top: 14px;
        border-radius: 14px;
        border: 1px solid #eef0f7;
        background: #111827;
    }

    .feed-counts {
        margin-top: 14px;
        padding: 0 2px 10px;
        display: flex;
        align-items: center;
        gap: 16px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 650;
    }

    .feed-actions {
        padding: 8px 0;
        border-top: 1px solid #eef0f3;
        border-bottom: 1px solid #eef0f3;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-items: center;
        gap: 6px;
    }

    .feed-action {
        width: 100%;
        border: none;
        background: transparent;
        color: #4b5563;
        font-size: 13px;
        font-weight: 750;
        padding: 9px 10px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
        text-align: center;
    }

        .feed-action:hover {
            background: #f3f4f6;
            color: #111827;
        }

        .feed-action.liked {
            color: #4f46e5;
            background: #eef2ff;
        }

    .feed-action-form {
        margin: 0;
        width: 100%;
    }

    .comments-panel {
        display: none;
        margin-top: 12px;
        padding-top: 2px;
    }

        .comments-panel.open {
            display: block;
        }

    .comment-form {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
    }

    .comment-input {
        flex: 1;
        min-width: 0;
        height: 42px;
        border: 1px solid #d7dce3;
        border-radius: 22px;
        padding: 0 15px;
        outline: none;
        background: #f8fafc;
        font-family: inherit;
        font-size: 13px;
        color: #111827;
    }

        .comment-input:focus {
            border-color: #6674ff;
            box-shadow: 0 0 0 3px rgba(102,116,255,.08);
        }

    .comment-submit {
        height: 42px;
        border: none;
        border-radius: 22px;
        padding: 0 17px;
        background: #111827;
        color: white;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .comment-item {
        padding: 8px 0 4px;
        border-bottom: none;
    }

        .comment-item:last-child {
            border-bottom: none;
        }

    .comment-meta {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 3px;
    }

    .comment-user {
        font-size: 13px;
        font-weight: 850;
        color: #111827;
    }

    .comment-time {
        font-size: 11px;
        color: #9ca3af;
    }

    .comment-text {
        display: inline-block;
        max-width: 92%;
        padding: 8px 11px;
        border-radius: 12px;
        background: #f3f4f6;
        font-size: 13px;
        line-height: 1.45;
        color: #374151;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .share-status {
        margin-left: auto;
        font-size: 11px;
        color: #059669;
        font-weight: 750;
    }

    .feed-empty {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        color: #6b7280;
    }

        .feed-empty h4 {
            margin: 0 0 5px;
            color: #111827;
        }

    /* ================= RIGHT PROFILE ================= */

    .right-column {
        position: sticky;
        top: 20px;
    }

    .side-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
    }

    .profile-summary {
        text-align: center;
    }

    .profile-large-avatar {
        width: 68px;
        height: 68px;
        margin: 0 auto 11px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-size: 23px;
        font-weight: 900;
    }

    .profile-summary h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 900;
    }

    .profile-summary p {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 12px;
    }

    .side-divider {
        height: 1px;
        background: #f1f5f9;
        margin: 16px 0;
    }

    .side-link {
        display: block;
        text-decoration: none;
        color: #6674ff;
        font-size: 13px;
        font-weight: 800;
        margin-top: 10px;
    }

        .side-link:hover {
            color: #4f5bea;
        }

    /* ================= SKILLS ================= */

    /* ================= RECOMMENDED SKILLS ================= */

    .skills-section {
        margin-top: 10px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 15px;
        margin-bottom: 18px;
    }

        .section-header h3 {
            margin: 0;
            font-size: 21px;
            font-weight: 900;
        }

        .section-header p {
            margin: 4px 0 0;
            color: #6b7280;
            font-size: 12px;
        }

    .view-all {
        text-decoration: none;
        color: #6674ff;
        font-size: 13px;
        font-weight: 800;
    }

        .view-all:hover {
            color: #ff64aa;
        }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .skill-item {
        min-width: 0;
    }

    .skill-card {
        height: 100%;
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .skill-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 22px 45px rgba(102, 116, 255, 0.15);
        }

    .match-badge {
        position: absolute;
        top: 18px;
        right: 18px;
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
        border: 1px solid rgba(34, 197, 94, 0.18);
    }

    .skill-card-icon {
        font-size: 30px;
        margin-bottom: 11px;
    }

    .skill-title {
        font-size: 20px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 7px;
        padding-right: 95px;
    }

    .rating-container {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .stars {
        color: #ffb100;
        font-size: 15px;
        letter-spacing: 1px;
    }

    .rating-text {
        font-size: 11px;
        color: #6b7280;
        font-weight: 650;
        background: #f3f4f6;
        padding: 3px 8px;
        border-radius: 12px;
    }

    .skill-description {
        color: #6b7280;
        line-height: 1.6;
        margin: 0 0 13px;
        flex: 1;
        font-size: 13px;
    }

    .owner {
        font-size: 12px;
        color: #8a93a3;
        font-weight: 650;
        margin-bottom: 15px;
    }

    .skill-actions {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .request-btn,
    .message-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 24px;
        padding: 9px 15px;
        font-size: 12px;
        font-weight: 800;
        transition: 0.2s;
    }

    .request-btn {
        border: none;
        cursor: pointer;
        background: #111827;
        color: white;
    }

    .message-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .request-btn:hover {
        background: #1f2937;
        color: white;
        transform: translateY(-1px);
    }

    .message-btn:hover {
        background: #e0e7ff;
        color: #4338ca;
        transform: translateY(-1px);
    }


    /* ================= SHARE TO CHAT ================= */

    .share-modal {
        position: fixed;
        inset: 0;
        z-index: 12000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(17, 24, 39, 0.48);
        backdrop-filter: blur(3px);
    }

        .share-modal.open {
            display: flex;
        }

    .share-dialog {
        width: min(460px, 100%);
        max-height: 75vh;
        overflow: hidden;
        background: white;
        border-radius: 20px;
        box-shadow: 0 24px 70px rgba(17, 24, 39, 0.25);
        display: flex;
        flex-direction: column;
    }

    .share-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

        .share-dialog-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            color: #111827;
        }

    .share-close-btn {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: #f3f4f6;
        color: #374151;
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
    }

    .share-dialog-subtitle {
        margin: 0;
        padding: 13px 20px;
        color: #6b7280;
        font-size: 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .share-recipient-list {
        overflow-y: auto;
        padding: 8px 12px 14px;
    }

    .share-recipient {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 8px;
        border-radius: 12px;
    }

        .share-recipient:hover {
            background: #f8fafc;
        }

    .share-recipient-avatar {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        font-size: 14px;
        font-weight: 900;
    }

    .share-recipient-name {
        flex: 1;
        min-width: 0;
        color: #111827;
        font-size: 14px;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .share-send-btn {
        border: none;
        border-radius: 20px;
        padding: 8px 15px;
        background: #6674ff;
        color: white;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s;
    }

        .share-send-btn:hover:not(:disabled) {
            background: #5664ef;
            transform: translateY(-1px);
        }

        .share-send-btn:disabled {
            background: #d1d5db;
            color: #6b7280;
            cursor: default;
        }

    .share-empty,
    .share-loading,
    .share-error {
        padding: 28px 18px;
        text-align: center;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.6;
    }

    .share-error {
        color: #b91c1c;
    }

    .share-open-messages {
        display: inline-block;
        margin-top: 10px;
        color: #6674ff;
        font-weight: 800;
        text-decoration: none;
    }

    /* ================= CHATBOT ================= */

    #chatButton {
        position: fixed;
        bottom: 22px;
        right: 22px;
        width: 62px;
        height: 62px;
        border-radius: 50%;
