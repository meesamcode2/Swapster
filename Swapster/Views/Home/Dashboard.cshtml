        font-weight: 900;
        font-size: 17px;
    }

    #chatMessages {
        flex: 1;
        padding: 13px;
        overflow-y: auto;
        font-size: 14px;
        background: #f6f8ff;
    }

    .user-msg {
        background: #6674ff;
        color: white;
        padding: 10px;
        border-radius: 14px 14px 4px 14px;
        margin-bottom: 10px;
        max-width: 85%;
