    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1100px) {

        .social-layout {
            grid-template-columns: 1fr;
        }

        .right-column {
            position: static;
        }

        .skills-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {

        .dashboard-layout {
            display: block;
        }

        .sidebar {
            position: relative;
            width: 100%;
            min-height: auto;
        }

        .main {
            width: 100%;
            margin-left: 0;
            padding: 16px;
        }

        .topbar {
