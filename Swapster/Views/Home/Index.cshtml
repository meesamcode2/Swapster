@model Swapster.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
<h2 class="mb-4">Welcome, @Model.UserName 👋</h2>

<div class="row">

    <!-- Total Skills -->
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">Your Posted Skills</div>
            <div class="card-body">
                <h4>@Model.TotalSkills</h4>
            </div>
        </div>
    </div>

    <!-- Incoming Requests -->
    <div class="col-md-4">
        <div class="card text-white bg-info mb-3">
            <div class="card-header">Incoming Requests</div>
            <div class="card-body">
                <h4>@Model.IncomingRequests</h4>
            </div>
        </div>
    </div>

    <!-- Outgoing Requests -->
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">Outgoing Requests</div>
            <div class="card-body">
                <h4>@Model.OutgoingRequests</h4>
            </div>
        </div>
    </div>

    <!-- Total Requests -->
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total Requests</div>
            <div class="card-body">
                <h4>@Model.TotalRequests</h4>
            </div>
        </div>
    </div>

    <!-- Completed Swaps -->
    <div class="col-md-4">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-header">Completed Swaps</div>
            <div class="card-body">
                <h4>@Model.CompletedSwaps</h4>
            </div>
        </div>
    </div>

</div>

<hr />

<h3>Your Posted Skills</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Skill Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var skill in Model.PostedSkills)
        {
            <tr>
                <td>@skill.SkillName</td>
                <td>@skill.Description</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>Recommended For You</h3>

@if (Model.RecommendedSkills.Count == 0)
{
    <p>No recommendations yet. (AI system coming soon)</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Skill Name</th>
                <th>Description</th>
                <th>Teacher</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in Model.RecommendedSkills)
            {
                <tr>
                    <td>@skill.SkillName</td>
                    <td>@skill.Description</td>
                    <td>@skill.User?.Username</td>
                </tr>
            }
        </tbody>
    </table>
}


