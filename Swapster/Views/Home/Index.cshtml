@model Swapster.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2>Welcome, @Model.UserName 👋</h2>

<div class="row mt-4">

    <div class="col-md-4">
        <div class="card bg-primary text-white mb-3">
            <div class="card-header">Your Skills</div>
            <div class="card-body"><h4>@Model.TotalSkills</h4></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-info text-white mb-3">
            <div class="card-header">Incoming Requests</div>
            <div class="card-body"><h4>@Model.IncomingRequests</h4></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-warning text-white mb-3">
            <div class="card-header">Outgoing Requests</div>
            <div class="card-body"><h4>@Model.OutgoingRequests</h4></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-success text-white mb-3">
            <div class="card-header">Total Requests</div>
            <div class="card-body"><h4>@Model.TotalRequests</h4></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-secondary text-white mb-3">
            <div class="card-header">Completed Swaps</div>
            <div class="card-body"><h4>@Model.CompletedSwaps</h4></div>
        </div>
    </div>

</div>

<hr />

<h3>Your Skills</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Skill</th>
            <th>Description</th>
            <th>Action</th> <!-- NEW COLUMN for request -->
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.MySkills)
        {
            <tr>
                <td>@s.SkillName</td>
                <td>@s.Description</td>
                <td>
                    <!-- SEND REQUEST BUTTON -->
                    <a asp-controller="Request"
                       asp-action="Send"
                       asp-route-skillId="@s.SkillId"
                       asp-route-receiverId="@s.UserId"
                       class="btn btn-primary btn-sm">
                        Request Skill
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>Recommended Skills (AI)</h3>

@if (Model.RecommendedSkills.Count == 0)
{
    <p>No recommendations yet — AI engine coming soon.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Skill</th>
                <th>Description</th>
                <th>Teacher</th>
                <th>Action</th> <!-- NEW COLUMN for request -->
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.RecommendedSkills)
            {
                <tr>
                    <td>@r.SkillName</td>
                    <td>@r.Description</td>
                    <td>@r.User?.Username</td>
                    <td>
                        <a asp-controller="Request"
                           asp-action="Send"
                           asp-route-skillId="@r.SkillId"
                           asp-route-receiverId="@r.UserId"
                           class="btn btn-success btn-sm">
                            Request Skill
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}