@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Privacy Policy</h1>

    <p>
        Welcome to <strong>Swapster</strong>. Your privacy is important to us.
        This Privacy Policy explains how we collect, use, and protect your information.
    </p>

    <hr />

    <h4>1. Information We Collect</h4>
    <p>We may collect the following information:</p>
    <ul>
        <li>Name and profile details</li>
        <li>Email address</li>
        <li>Skills you offer and request</li>
        <li>Messages exchanged between users</li>
    </ul>

    <h4>2. How We Use Your Information</h4>
    <p>Your information is used to:</p>
    <ul>
        <li>Connect users for skill swapping</li>
        <li>Improve user experience</li>
        <li>Ensure platform security</li>
    </ul>

    <h4>3. Data Protection</h4>
    <p>
        We implement appropriate security measures to protect your data.
        However, no system is 100% secure.
    </p>

    <h4>4. Sharing of Information</h4>
    <p>
        We do not sell or share your personal information with third parties
        except when required by law.
    </p>

    <h4>5. User Responsibilities</h4>
    <p>
        Users are responsible for the information they share publicly
        on their profiles.
    </p>

    <h4>6. Cookies</h4>
    <p>
        Swapster may use cookies to enhance your experience.
    </p>

    <h4>7. Changes to Policy</h4>
    <p>
        We may update this policy from time to time.
        Changes will be posted on this page.
    </p>

    <h4>8. Contact Us</h4>
    <p>
        If you have any questions, contact us at:
        <br />
        <strong>Email:</strong> support@swapster.com
    </p>

    <!-- ✅ Added Terms Section -->
    <hr />

    <h4>Related Policies</h4>
    <p>
        Please also review our
        <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a>
        to understand the rules and responsibilities when using Swapster.
    </p>

    <hr />

    <p class="text-muted text-center">
        © 2026 Swapster. All rights reserved.
    </p>
</div>