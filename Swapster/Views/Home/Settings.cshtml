@{
    ViewData["Title"] = "Settings";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "dashboard-page";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .dashboard-layout {
        min-height: 100vh;
        display: flex;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.16), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.14), transparent 35%), #f6f8ff;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
        width: 260px;
        min-height: 100vh;
        background: linear-gradient(180deg, #111827, #1f1f3a);
        color: white;
        padding: 26px 20px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        overflow-y: auto;
        box-shadow: 18px 0 45px rgba(17, 24, 39, 0.18);
    }

    .sidebar-brand {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0;
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 34px;
        letter-spacing: -1px;
        transition: 0.25s;
    }

    .brand-swap {
        color: #d9573b;
    }

    .brand-ster {
        color: #6674ff;
    }

    .sidebar-brand:hover {
        transform: translateY(-2px);
    }

    .sidebar-menu {
        display: grid;
        gap: 8px;
    }

    .sidebar a.menu-link {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #d1d5db;
        padding: 13px 14px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 650;
        transition: 0.25s;
    }

        .sidebar a.menu-link:hover,
        .sidebar a.active {
            background: linear-gradient(135deg, #6674ff, #ff64aa);
            color: white;
            transform: translateX(4px);
            box-shadow: 0 12px 25px rgba(102, 116, 255, 0.22);
        }

    .logout-form {
        margin-top: 20px;
    }

    .logout-btn {
        width: 100%;
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.08);
        color: white;
        padding: 12px 14px;
        border-radius: 16px;
        font-weight: 750;
        transition: 0.25s;
        cursor: pointer;
    }

        .logout-btn:hover {
            background: rgba(255, 100, 170, 0.22);
        }

    /* ================= MAIN ================= */

    .main {
        margin-left: 260px;
        width: calc(100% - 260px);
        padding: 30px;
    }

    .topbar {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(18px);
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 22px 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
        margin-bottom: 28px;
    }

        .topbar h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 900;
            color: #111827;
            letter-spacing: -0.8px;
        }

        .topbar p {
            margin: 7px 0 0;
            color: #6b7280;
            font-size: 15px;
        }

    /* ================= SETTINGS ================= */

    .settings-hero {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        border-radius: 32px;
        padding: 32px;
        margin-bottom: 28px;
        box-shadow: 0 24px 55px rgba(102, 116, 255, 0.24);
        position: relative;
        overflow: hidden;
    }

        .settings-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255,255,255,0.13);
            right: -70px;
            top: -80px;
        }

        .settings-hero h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1.2px;
            position: relative;
            z-index: 2;
        }

        .settings-hero p {
            margin: 12px 0 0;
            max-width: 650px;
            line-height: 1.7;
            opacity: 0.95;
            position: relative;
            z-index: 2;
        }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .settings-card {
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 26px;
        padding: 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.07);
    }

        .settings-card h3 {
            margin: 0 0 6px;
            color: #111827;
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.5px;
        }

        .settings-card .card-subtitle {
            margin: 0 0 22px;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

    .setting-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 15px 0;
        border-bottom: 1px solid #eef0f7;
    }

        .setting-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .setting-info h4 {
        margin: 0 0 5px;
        color: #111827;
        font-size: 15px;
        font-weight: 850;
    }

    .setting-info p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.5;
    }

    .setting-value {
        color: #6674ff;
        font-weight: 850;
        font-size: 14px;
        white-space: nowrap;
    }

    .setting-btn {
        border: none;
        outline: none;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        padding: 10px 15px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 850;
        cursor: pointer;
        transition: 0.25s;
        text-decoration: none;
        white-space: nowrap;
    }

        .setting-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(102, 116, 255, 0.22);
        }

    .outline-btn {
        background: white;
        color: #6674ff;
        border: 1px solid #dbe0ff;
    }

        .outline-btn:hover {
            background: #f6f8ff;
            color: #6674ff;
        }

    .danger-btn {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #fecdd3;
    }

        .danger-btn:hover {
            background: #e11d48;
            color: white;
        }

    /* ================= SWITCH ================= */

    .switch {
        position: relative;
        width: 50px;
        height: 28px;
        flex-shrink: 0;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #e5e7eb;
        border-radius: 30px;
        transition: 0.25s;
    }

        .slider::before {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            left: 3px;
            top: 3px;
            background: white;
            border-radius: 50%;
            transition: 0.25s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.16);
        }

    .switch input:checked + .slider {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
    }

        .switch input:checked + .slider::before {
            transform: translateX(22px);
        }

    .save-area {
        margin-top: 28px;
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 26px;
        padding: 22px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.07);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

        .save-area h4 {
            margin: 0 0 5px;
            color: #111827;
            font-weight: 900;
        }

        .save-area p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

    .save-btn {
        border: none;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        padding: 13px 20px;
        border-radius: 35px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 25px rgba(102, 116, 255, 0.22);
        transition: 0.25s;
    }

        .save-btn:hover {
            transform: translateY(-2px);
        }

    @@media (max-width: 1100px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-layout {
            display: block;
        }

        .sidebar {
            position: relative;
            width: 100%;
            min-height: auto;
            border-radius: 0 0 28px 28px;
        }

        .main {
            width: 100%;
            margin-left: 0;
            padding: 22px;
        }

        .settings-hero h1 {
            font-size: 30px;
        }

        .save-area {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="dashboard-layout">



    <aside class="sidebar">

        <a asp-controller="Home" asp-action="Dashboard" class="sidebar-brand">
            <span class="brand-swap">Swap</span><span class="brand-ster">ster</span>
        </a>

        <div class="sidebar-menu">

            <a asp-controller="Home" asp-action="Dashboard" class="menu-link">
                📊 Dashboard
            </a>

            <a asp-controller="Skill" asp-action="Index" class="menu-link">
                🔍 Explore Skills
            </a>

            <a asp-controller="Home" asp-action="Dashboard" asp-fragment="trending" class="menu-link">
                ⚡ Trending Skills
            </a>

            <a asp-controller="Account" asp-action="MyAccount" class="menu-link">
                👤 My Account
            </a>

            <a asp-controller="Home" asp-action="Settings" class="menu-link active">
                ⚙ Settings
            </a>

        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
            <button type="submit" class="logout-btn">
                Logout
            </button>
        </form>

    </aside>

    <!-- ================= MAIN CONTENT ================= -->

    <main class="main">

         <section class="settings-hero">
            <h1>Account Settings ⚙</h1>
            <p>
                Control how your profile appears, manage notifications, update security preferences,
                and customize your Swapster experience.
            </p>
        </section>

        <section class="settings-grid">

            <!-- Account Settings -->
            <div class="settings-card">
                <h3>👤 Account Settings</h3>
                <p class="card-subtitle">Basic account information and login details.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Username</h4>
                        <p>Your display name on Swapster.</p>
                    </div>
                    <span class="setting-value">@ViewBag.Username</span>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Email Address</h4>
                        <p>Email used for login and account recovery.</p>
                    </div>
                    <span class="setting-value">@ViewBag.Email</span>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Password</h4>
                        <p>Change your account password.</p>
                    </div>
                    <a asp-controller="Account"
                       asp-action="ChangePassword"
                       class="setting-btn">
                        Change
                    </a>
                </div>
            </div>

            <!-- Profile Settings -->
            <div class="settings-card">
                <h3>🧑‍💻 Profile Settings</h3>
                <p class="card-subtitle">Control how your skill profile appears to other users.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Public Profile</h4>
                        <p>Allow other users to view your skills.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Show My Skills</h4>
                        <p>Display your teaching skills in search results.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Profile Completion</h4>
                        <p>Update your bio, skills and learning interests.</p>
                    </div>
                    <a href="/Skill/Index" class="setting-btn outline-btn">Edit</a>
                </div>
            </div>

            <!-- Notification Settings -->
            <div class="settings-card">
                <h3>🔔 Notification Settings</h3>
                <p class="card-subtitle">Choose which updates you want to receive.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Email Notifications</h4>
                        <p>Receive important updates through email.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Skill Request Alerts</h4>
                        <p>Get notified when someone requests your skill.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Recommendation Updates</h4>
                        <p>Receive updates for new compatible matches.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Privacy Settings -->
            <div class="settings-card">
                <h3>🔐 Privacy Settings</h3>
                <p class="card-subtitle">Manage privacy and profile visibility controls.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Show Email to Others</h4>
                        <p>Allow matched users to view your email.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Allow Match Suggestions</h4>
                        <p>Let Swapster suggest your profile to compatible users.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Profile Search Visibility</h4>
                        <p>Allow your profile to appear in skill search.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Appearance Settings -->
            <div class="settings-card">
                <h3>🎨 Appearance Settings</h3>
                <p class="card-subtitle">Customize how Swapster looks for you.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Theme Mode</h4>
                        <p>Current theme style.</p>
                    </div>
                    <span class="setting-value">Light</span>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Brand Color</h4>
                        <p>Swapster default gradient colors.</p>
                    </div>
                    <span class="setting-value">Default</span>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Compact Dashboard</h4>
                        <p>Reduce spacing in dashboard cards.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- AI Assistant Settings -->
            <div class="settings-card">
                <h3>💡 AI Assistant Settings</h3>
                <p class="card-subtitle">Manage Swapster chatbot and recommendation behavior.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Enable Swapster AI</h4>
                        <p>Show chatbot on dashboard pages.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Personalized Recommendations</h4>
                        <p>Use your skills to suggest better matches.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Career Guidance</h4>
                        <p>Allow AI assistant to provide career roadmaps.</p>
                    </div>

                    <label class="switch">
                        <input type="checkbox" checked />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Danger Zone -->
            <div class="settings-card">
                <h3>⚠ Account Actions</h3>
                <p class="card-subtitle">Important account-related actions.</p>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Download Account Data</h4>
                        <p>Get a copy of your profile and skill data.</p>
                    </div>
                    <a href="#" class="setting-btn outline-btn">Download</a>
                </div>

                <div class="setting-row">
                    <div class="setting-info">
                        <h4>Deactivate Account</h4>
                        <p>Temporarily disable your Swapster account.</p>
                    </div>
                    <a href="#" class="setting-btn danger-btn">Deactivate</a>
                </div>
            </div>

        </section>

        <div class="save-area">
            <div>
                <h4>Save your settings</h4>
                <p>These switches are UI-ready. Backend saving can be connected with database later.</p>
            </div>

            <button type="button" class="save-btn" onclick="saveSettings()">
                Save Settings
            </button>
        </div>

    </main>

</div>

<script>
    function saveSettings() {
        alert("Settings saved successfully!");
    }
</script>