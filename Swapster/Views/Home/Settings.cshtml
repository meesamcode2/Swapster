@{
    ViewData["Title"] = "Settings";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
    ViewData["BodyClass"] = "dashboard-page";

    bool isEmailVerified =
        ViewBag.IsEmailVerified is bool verified &&
        verified;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

    .dashboard-layout {
        min-height: 100vh;
        display: flex;
        background: radial-gradient( circle at top left, rgba(104, 124, 255, 0.16), transparent 35% ), radial-gradient( circle at bottom right, rgba(255, 100, 170, 0.14), transparent 35% ), #f6f8ff;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
        width: 260px;
        min-height: 100vh;
        background: linear-gradient(180deg, #111827, #1f1f3a);
        color: white;
        padding: 26px 20px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        overflow-y: auto;
        box-shadow: 18px 0 45px rgba(17, 24, 39, 0.18);
    }

    .sidebar-brand {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 34px;
        letter-spacing: -1px;
        transition: 0.25s;
    }

        .sidebar-brand:hover {
            transform: translateY(-2px);
        }

    .brand-swap {
        color: #d9573b;
    }

    .brand-ster {
        color: #6674ff;
    }

    .sidebar-menu {
        display: grid;
        gap: 8px;
    }

    .menu-link {
        display: flex;
        align-items: center;
        color: #d1d5db;
        padding: 13px 14px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 650;
        transition: 0.25s;
    }

        .menu-link:hover,
        .menu-link.active {
            background: linear-gradient(135deg, #6674ff, #ff64aa);
            color: white;
            transform: translateX(4px);
            box-shadow: 0 12px 25px rgba(102, 116, 255, 0.22);
        }

    .sidebar-logout-form {
        margin-top: 20px;
    }

    .sidebar-logout-btn {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.08);
        color: white;
        padding: 12px 14px;
        border-radius: 16px;
        font-weight: 750;
        transition: 0.25s;
        cursor: pointer;
    }

        .sidebar-logout-btn:hover {
            background: rgba(255, 100, 170, 0.22);
        }

    /* ================= MAIN ================= */

    .main {
        margin-left: 260px;
        width: calc(100% - 260px);
        padding: 30px;
    }

    .settings-hero {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        border-radius: 32px;
        padding: 32px;
        margin-bottom: 28px;
        box-shadow: 0 24px 55px rgba(102, 116, 255, 0.24);
        position: relative;
        overflow: hidden;
    }

        .settings-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.13);
            right: -70px;
            top: -80px;
        }

        .settings-hero h1 {
            margin: 0;
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1.2px;
            position: relative;
            z-index: 2;
        }

        .settings-hero p {
            margin: 12px 0 0;
            max-width: 650px;
            line-height: 1.7;
            opacity: 0.95;
            position: relative;
            z-index: 2;
        }

    /* ================= ALERTS ================= */

    .alert-success,
    .alert-error {
        padding: 14px 16px;
        border-radius: 16px;
        margin-bottom: 20px;
        font-weight: 700;
        font-size: 14px;
    }

    .alert-success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    /* ================= SETTINGS ================= */

    .settings-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
        gap: 22px;
        align-items: start;
    }

    .settings-card {
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 26px;
        padding: 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.07);
    }

        .settings-card h3 {
            margin: 0 0 6px;
            color: #111827;
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -0.5px;
        }

    .card-subtitle {
        margin: 0 0 22px;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
    }

    .setting-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 17px 0;
        border-bottom: 1px solid #eef0f7;
    }

        .setting-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .setting-info {
        min-width: 0;
    }

        .setting-info h4 {
            margin: 0 0 5px;
            color: #111827;
            font-size: 15px;
            font-weight: 850;
        }

        .setting-info p {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
            line-height: 1.5;
        }

    .setting-value {
        color: #4f46e5;
        font-weight: 850;
        font-size: 14px;
        text-align: right;
        word-break: break-word;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 850;
        white-space: nowrap;
    }

    .status-verified {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .status-unverified {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    .action-form {
        margin: 0;
        flex-shrink: 0;
    }

    .setting-btn {
        border: none;
        outline: none;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white;
        padding: 10px 15px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 850;
        cursor: pointer;
        transition: 0.25s;
        text-decoration: none;
        white-space: nowrap;
    }

        .setting-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(102, 116, 255, 0.22);
        }

    .outline-btn {
        background: white;
        color: #6674ff;
        border: 1px solid #dbe0ff;
    }

        .outline-btn:hover {
            background: #f6f8ff;
            color: #6674ff;
        }

    .danger-btn {
        background: #fff1f2;
        color: #e11d48;
        border: 1px solid #fecdd3;
    }

        .danger-btn:hover {
            background: #e11d48;
            color: white;
        }

    .logout-action-btn {
        background: #111827;
        color: white;
    }

        .logout-action-btn:hover {
            background: #1f2937;
        }

    .verification-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .danger-card {
        border-color: #fee2e2;
    }

    .danger-note {
        margin-top: 20px;
        padding: 14px;
        border-radius: 15px;
        background: #fff7f7;
        border: 1px solid #fee2e2;
        color: #7f1d1d;
        font-size: 12px;
        line-height: 1.6;
    }

    @@media (max-width: 1050px) {
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-layout {
            display: block;
        }

        .sidebar {
            position: relative;
            width: 100%;
            min-height: auto;
            border-radius: 0 0 28px 28px;
        }

        .main {
            width: 100%;
            margin-left: 0;
            padding: 22px;
        }

        .settings-hero h1 {
            font-size: 30px;
        }

        .setting-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .setting-value {
            text-align: left;
        }

        .verification-actions {
            justify-content: flex-start;
        }
    }
</style>

<div class="dashboard-layout">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="sidebar-brand">

            <span class="brand-swap">Swap</span><span class="brand-ster">ster</span>
        </a>

        <div class="sidebar-menu">

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="menu-link">
                Dashboard
            </a>

            <a asp-controller="Skill"
               asp-action="Index"
               class="menu-link">
                Explore Skills
            </a>

            <a asp-controller="SkillRequest"
               asp-action="MyExchanges"
               class="menu-link">
                My Exchanges
            </a>

            <a asp-controller="Account"
               asp-action="MyAccount"
               class="menu-link">
                My Account
            </a>

            <a asp-controller="Home"
               asp-action="Settings"
               class="menu-link active">
                Settings
            </a>

        </div>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="sidebar-logout-form">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="sidebar-logout-btn">
                Logout
            </button>

        </form>

    </aside>

    <!-- ================= MAIN ================= -->

    <main class="main">

        <section class="settings-hero">

            <h1>Account Settings</h1>

            <p>
                View your account information, manage password security,
                verify your email and control your account status.
            </p>

        </section>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                @TempData["Error"]
            </div>
        }

        <section class="settings-grid">

            <!-- ================= ACCOUNT & SECURITY ================= -->

            <div class="settings-card">

                <h3>Account & Security</h3>

                <p class="card-subtitle">
                    Your login information and account security options.
                </p>

                <div class="setting-row">

                    <div class="setting-info">
                        <h4>Username</h4>
                        <p>Your Swapster display name.</p>
                    </div>

                    <span class="setting-value">
                        @ViewBag.Username
                    </span>

                </div>

                <div class="setting-row">

                    <div class="setting-info">
                        <h4>Email Address</h4>
                        <p>
                            Email used for login, verification
                            and password recovery.
                        </p>
                    </div>

                    <span class="setting-value">
                        @ViewBag.Email
                    </span>

                </div>

                <div class="setting-row">

                    <div class="setting-info">
                        <h4>Email Verification</h4>

                        @if (isEmailVerified)
                        {
                            <p>
                                Your email address has been verified.
                            </p>
                        }
                        else
                        {
                            <p>
                                Verify your email before publishing skills.
                            </p>
                        }
                    </div>

                    @if (isEmailVerified)
                    {
                        <span class="status-badge status-verified">
                            Verified
                        </span>
                    }
                    else
                    {
                        <div class="verification-actions">

                            <span class="status-badge status-unverified">
                                Not Verified
                            </span>

                            <form asp-controller="Account"
                                  asp-action="ResendVerification"
                                  method="post"
                                  class="action-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="setting-btn outline-btn">
                                    Resend Email
                                </button>

                            </form>

                        </div>
                    }

                </div>

                <div class="setting-row">

                    <div class="setting-info">
                        <h4>Change Password</h4>
                        <p>
                            We will send a secure password-reset link
                            to your current email address.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="SendPasswordResetLink"
                          method="post"
                          class="action-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="setting-btn">
                            Send Reset Link
                        </button>

                    </form>

                </div>

            </div>

            <!-- ================= ACCOUNT ACTIONS ================= -->

            <div class="settings-card danger-card">

                <h3>Account Actions</h3>

                <p class="card-subtitle">
                    Session and account-status controls.
                </p>

                <div class="setting-row">

                    <div class="setting-info">
                        <h4>Deactivate Account</h4>
                        <p>
                            Temporarily disable your Swapster account.
                        </p>
                    </div>

                    <form asp-controller="Home"
                          asp-action="DeactivateAccount"
                          method="post"
                          class="action-form"
                          onsubmit="return confirm('Are you sure you want to deactivate your Swapster account?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="setting-btn danger-btn">
                            Deactivate
                        </button>

                    </form>

                </div>


                <div class="danger-note">
                    After deactivation , an administrator must be reached to reactivate Account.
                </div>

            </div>

        </section>

    </main>

</div>
