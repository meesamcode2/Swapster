<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Swapster</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Swapster.styles.css" asp-append-version="true" />

    <link rel="icon" type="image/svg+xml" href="~/images/swapster.svg" />
    <link rel="shortcut icon" type="image/svg+xml" href="~/images/swapster.svg" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            background: #f6f8ff;
            color: #111827;
        }

        /* ================= DEFAULT THEME NAVBAR ================= */

        .swapster-navbar {
            width: 100%;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid #eef0f7;
            box-shadow: 0 12px 30px rgba(35, 45, 90, 0.06);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .swapster-nav-inner {
            width: 100%;
            padding: 16px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .layout-brand {
            text-decoration: none;
            color: #d9573b;
            font-size: 28px;
            font-weight: 900;
            letter-spacing: -0.8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .layout-brand span {
                color: #6674ff;
            }

        .brand-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6674ff, #ff64aa);
            box-shadow: 0 0 18px rgba(102, 116, 255, 0.45);
        }

        /* ✅ DESKTOP NAV AREA FIX */
        .layout-nav-area {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .layout-nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .layout-nav-links a {
                text-decoration: none;
                color: #4b5563;
                font-weight: 700;
                font-size: 15px;
                padding: 10px 14px;
                border-radius: 14px;
                transition: 0.25s;
                white-space: nowrap;
            }

                .layout-nav-links a:hover {
                    background: #eef1ff;
                    color: #6674ff;
                }

        .layout-auth-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .layout-login-link {
            text-decoration: none;
            color: #4b5563;
            font-weight: 800;
            padding: 10px 14px;
            border-radius: 14px;
            transition: 0.25s;
            white-space: nowrap;
        }

            .layout-login-link:hover {
                background: #eef1ff;
                color: #6674ff;
            }

        .layout-signup-btn {
            text-decoration: none;
            border: none;
            background: linear-gradient(135deg, #6674ff, #ff64aa);
            color: white !important;
            padding: 11px 20px;
            border-radius: 35px;
            font-weight: 900;
            box-shadow: 0 12px 24px rgba(102, 116, 255, 0.25);
            transition: 0.25s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

            .layout-signup-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 32px rgba(102, 116, 255, 0.32);
            }

        .layout-logout-btn {
            border: none;
            background: #111827;
            color: white;
            padding: 11px 18px;
            border-radius: 35px;
            font-weight: 850;
            transition: 0.25s;
            white-space: nowrap;
        }

            .layout-logout-btn:hover {
                background: #1f2937;
                transform: translateY(-2px);
            }

        .mobile-menu-btn {
            display: none;
            border: none;
            background: #eef1ff;
            color: #6674ff;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            font-size: 22px;
            font-weight: 900;
        }

        .layout-page-shell {
            min-height: calc(100vh - 80px);
        }

        .layout-container {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 32px 22px;
        }

        /* ================= FOOTER ================= */

        .layout-footer {
            background: white;
            border-top: 1px solid #eef0f7;
            padding: 28px 7%;
            color: #6b7280;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .footer-brand {
            font-weight: 900;
            color: #111827;
        }

            .footer-brand span {
                color: #6674ff;
            }

        .footer-links {
            display: flex;
            gap: 16px;
            align-items: center;
        }

            .footer-links a {
                text-decoration: none;
                color: #6b7280;
                font-weight: 700;
                transition: 0.25s;
            }

                .footer-links a:hover {
                    color: #6674ff;
                }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 900px) {
            .swapster-nav-inner {
                padding: 15px 22px;
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .mobile-menu-btn {
                display: inline-grid;
                place-items: center;
            }

            .layout-nav-area {
                width: 100%;
                display: none;
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
                margin-top: 16px;
            }

                .layout-nav-area.show {
                    display: flex;
                }

            .layout-nav-links {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

                .layout-nav-links a {
                    display: block;
                    width: 100%;
                }

            .layout-auth-actions {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

                .layout-auth-actions a,
                .layout-auth-actions button {
                    width: 100%;
                    text-align: center;
                }
        }

        @@media (max-width: 576px) {
            .layout-brand {
                font-size: 24px;
            }

            .layout-container {
                padding: 24px 18px;
            }

            .footer-inner {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

@{
            var bodyClass = ViewData["BodyClass"]?.ToString() ?? "";
            var hideNavbar = ViewData["HideNavbar"] != null;

            var fullWidth =
                            ViewData["FullWidth"] != null ||
                            bodyClass == "auth-page" ||
                            bodyClass == "landing-page" ||
                            bodyClass == "dashboard-page" ||
                            bodyClass == "privacy-page" ||
                            bodyClass == "terms-page" ||
                            bodyClass == "skills-page";

            var isLoggedIn = Context.Session.GetInt32("UserId") != null;
}

<body class="@bodyClass">

    <div id="pageLoader">
        <div class="loader-card">
            <div class="loader-logo">S</div>

            <div class="loader-brand">
                Swap<span>ster</span>
            </div>

            <div class="loader-text">
                Loading your skills...
            </div>

            <div class="loader-bar">
                <span></span>
            </div>
        </div>
    </div>

    @if (!hideNavbar)
    {
        <header class="swapster-navbar">
            <nav class="swapster-nav-inner">

                <a asp-controller="Home" asp-action="Index" class="layout-brand">
                    <span class="brand-dot"></span>
                    Swap<span>ster</span>
                </a>

                <button type="button" class="mobile-menu-btn" onclick="toggleLayoutMenu()">
                    ☰
                </button>

                <div class="layout-nav-area" id="layoutNavArea">

                    <ul class="layout-nav-links">
                        @if (isLoggedIn)
                        {
                            <li>
                                <a asp-controller="Home" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="layout-auth-actions">
                        @if (isLoggedIn)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="layout-logout-btn">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="layout-login-link">
                                Login
                            </a>

                            <a asp-controller="Account"
                               asp-action="Signup"
                               class="layout-signup-btn">
                                Join Swapster
                            </a>
                        }
                    </div>

                </div>

            </nav>
        </header>
    }

    @if (fullWidth)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <main role="main" class="layout-page-shell">
            <div class="layout-container">
                @RenderBody()
            </div>
        </main>
    }

    @if (!hideNavbar && !fullWidth)
    {
        <footer class="layout-footer">
            <div class="footer-inner">
                <div>
                    © 2026 <span class="footer-brand">Swap<span>ster</span></span>. All rights reserved.
                </div>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms">Terms</a>
                    <a asp-controller="Account" asp-action="Signup">Join</a>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleLayoutMenu() {
            const menu = document.getElementById("layoutNavArea");

            if (!menu) return;

            menu.classList.toggle("show");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.addEventListener("load", function () {
            const loader = document.getElementById("pageLoader");

            if (loader) {
                setTimeout(function () {
                    loader.classList.add("loader-hidden");
                }, 500);
            }
        });

        document.addEventListener("DOMContentLoaded", function () {
            const loader = document.getElementById("pageLoader");

            document.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function () {
                    const href = link.getAttribute("href");
                    const target = link.getAttribute("target");

                    if (
                        loader &&
                        href &&
                        !href.startsWith("#") &&
                        !href.startsWith("javascript") &&
                        target !== "_blank"
                    ) {
                        loader.classList.remove("loader-hidden");
                    }
                });
            });

            document.querySelectorAll("form").forEach(function (form) {
                form.addEventListener("submit", function () {
                    if (loader) {
                        loader.classList.remove("loader-hidden");
                    }
                });
            });
        });
    </script>

</body>
</html>