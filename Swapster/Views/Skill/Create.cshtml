@model Swapster.Models.AddSkillViewModel

@{
    ViewData["Title"] = "Setup Your Skill Swap";
}

<style>
    .swap-card {
        background: white;
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 20px 45px rgba(35, 45, 90, 0.08);
        max-width: 750px;
        margin: 40px auto;
        border: 1px solid #eef0f7;
    }

    .main-title {
        font-weight: 950;
        text-align: center;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 30px;
    }

    .section-divider {
        border-top: 2px dashed #e5e7eb;
        margin: 30px 0;
        position: relative;
    }

    .section-badge {
        position: absolute;
        top: -12px;
        left: 20px;
        background: #f6f8ff;
        padding: 2px 14px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 13px;
        color: #6674ff;
    }

    .form-label {
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 12px 16px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #6674ff;
            box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.13);
            outline: none;
        }

    .submit-btn {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        border: none;
        color: white;
        font-weight: 800;
        padding: 15px;
        border-radius: 35px;
        box-shadow: 0 12px 24px rgba(102, 116, 255, 0.25);
        width: 100%;
        margin-top: 20px;
        transition: 0.25s;
    }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(102, 116, 255, 0.32);
        }
</style>

<div class="container">
    <div class="swap-card">
        <h2 class="main-title"> Create a Skill Swap Entry</h2>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <h4 class="mb-3" style="font-weight: 800; color: #111827;"> What Can You Teach? (Your Offer)</h4>
                <div class="col-md-7 mb-3">
                    <label class="form-label">Skill Name</label>
                    <input asp-for="OfferedSkillName" class="form-control" placeholder="e.g., Python, C++, HTML" required />
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">Your Expertise Level</label>
                    <select asp-for="ProficiencyLevel" class="form-select" required>
                        <option value="1">⭐ Level 1 (Beginner)</option>
                        <option value="2">⭐⭐ Level 2 (Elementary)</option>
                        <option value="3">⭐⭐⭐ Level 3 (Intermediate)</option>
                        <option value="4">⭐⭐⭐⭐ Level 4 (Advanced)</option>
                        <option value="5">⭐⭐⭐⭐⭐ Level 5 (Expert)</option>
                    </select>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Brief Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tell others what you can help them learn..."></textarea>
                </div>
            </div>

            <div class="row">
                <h4 class="mb-3" style="font-weight: 800; color: #111827;"> What Do You Want to Learn? (Your Need)</h4>
                <div class="col-md-7 mb-3">
                    <label class="form-label">Skill Name</label>
                    <input asp-for="WantedSkillName" class="form-control" placeholder="e.g., JavaScript, Java, C" required />
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">Target Level to Achieve</label>
                    <select asp-for="DesiredLevel" class="form-select" required>
                        <option value="1">⭐ Level 1 (Basics)</option>
                        <option value="2">⭐⭐ Level 2 (Elementary)</option>
                        <option value="3">⭐⭐⭐ Level 3 (Intermediate)</option>
                        <option value="4">⭐⭐⭐⭐ Level 4 (Advanced)</option>
                        <option value="5">⭐⭐⭐⭐⭐ Level 5 (Mastery)</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="submit-btn">Publish Swap Entry </button>
        </form>
    </div>
</div>