@model IEnumerable<Swapster.Models.UserSkill>

@{
    ViewData["Title"] = "Available Skills";
    ViewData["BodyClass"] = "skills-page";
}

<style>
    .skills-page {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

        .skills-page * {
            box-sizing: border-box;
        }

    .skills-wrapper {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.18), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.15), transparent 35%), #f6f8ff;
        padding: 45px 7% 80px;
    }

    .skills-hero {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        border-radius: 34px;
        padding: 42px;
        color: white;
        box-shadow: 0 24px 55px rgba(102, 116, 255, 0.24);
        margin-bottom: 30px;
    }

        .skills-hero h1 {
            margin: 0;
            font-size: 48px;
            font-weight: 950;
            letter-spacing: -1.8px;
        }

        .skills-hero p {
            margin: 16px 0 0;
            max-width: 640px;
            line-height: 1.7;
            opacity: 0.94;
            font-size: 16px;
        }

    .skills-toolbar {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(18px);
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
    }

    .search-box {
        width: 100%;
        max-width: 460px;
        position: relative;
    }

        .search-box span {
            position: absolute;
            left: 17px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 18px;
        }

        .search-box input {
            width: 100%;
            height: 50px;
            border-radius: 18px;
            border: 1px solid #e5e7eb;
            padding: 12px 18px 12px 46px;
            outline: none;
            background: #f9fafb;
            color: #111827;
        }

            .search-box input:focus {
                border-color: #6674ff;
                box-shadow: 0 0 0 4px rgba(102, 116, 255, 0.10);
                background: white;
            }

    .add-skill-btn {
        text-decoration: none;
        border: none;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white !important;
        padding: 13px 22px;
        border-radius: 35px;
        font-weight: 900;
        box-shadow: 0 12px 24px rgba(102, 116, 255, 0.25);
        white-space: nowrap;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .skill-card {
        height: 100%;
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
        transition: 0.3s;
        display: flex;
        flex-direction: column;
    }

        .skill-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 45px rgba(102, 116, 255, 0.15);
        }

    .skill-title {
        font-size: 21px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 8px;
    }

    .skill-level {
        width: fit-content;
        margin: 0 0 14px;
        padding: 6px 11px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 700;
    }

    .skill-description {
        color: #6b7280;
        line-height: 1.65;
        margin-bottom: 12px;
        flex: 1;
    }

    .owner {
        font-size: 14px;
        color: #8a93a3;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .request-form {
        margin: 0;
    }

    .request-btn {
        width: fit-content;
        border: none;
        background: #111827;
        color: white;
        padding: 10px 17px;
        border-radius: 35px;
        font-size: 14px;
        font-weight: 850;
        cursor: pointer;
        font-family: inherit;
    }

        .request-btn:hover {
            background: #1f2937;
        }

    .empty-state {
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 24px;
        padding: 40px 20px;
        text-align: center;
        color: #6b7280;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.06);
    }

        .empty-state h3 {
            margin: 0;
            color: #111827;
        }

    .hidden {
        display: none !important;
    }

    @@media (max-width: 1000px) {
        .skills-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .skills-wrapper {
            padding: 25px 18px 50px;
        }

        .skills-hero {
            padding: 28px 22px;
            border-radius: 24px;
        }

            .skills-hero h1 {
                font-size: 36px;
            }

        .skills-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            max-width: none;
        }

        .add-skill-btn {
            text-align: center;
        }

        .skills-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="skills-wrapper">

    <section class="skills-hero">
        <div>
            <h1>Explore Skills</h1>

            <p>
                Browse skills shared by other Swapster users and send a swap request
                when you find something you want to learn.
            </p>
        </div>
    </section>

    <div class="skills-toolbar">

        <div class="search-box">
            <span>🔍</span>

            <input type="text"
                   id="skillSearch"
                   placeholder="Search skills by name..."
                   onkeyup="filterSkills()" />
        </div>

        <a asp-action="Create"
           class="add-skill-btn">
            + Add Your Skill
        </a>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="skills-grid"
             id="skillsGrid">

            @foreach (var item in Model)
            {
                var levelName = item.ProficiencyLevel switch
                {
                    1 => "Beginner",
                    2 => "Elementary",
                    3 => "Intermediate",
                    4 => "Advanced",
                    5 => "Expert",
                    _ => "Not Specified"
                };

                <div class="skill-item">

                    <div class="skill-card">

                        <div class="skill-title">
                            @item.SkillName
                        </div>

                        <div class="skill-level">
                            Level: @levelName
                        </div>

                        <p class="skill-description">
                            @(string.IsNullOrWhiteSpace(item.Description)
                                                ? "No description available."
                                                : item.Description)
                </p>

                        <div class="owner">
                            Offered by:
                            @(item.User?.Username ?? "Swapster User")
                        </div>

                        <form asp-controller="SkillRequest"
                              asp-action="Send"
                              method="post"
                              class="request-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="skillId"
                                   value="@item.SkillId" />

                            <input type="hidden"
                                   name="receiverId"
                                   value="@item.UserId" />

                            <button type="submit"
                                    class="request-btn">
                                Send Swap Request
                            </button>

                        </form>

                    </div>

                </div>
                }

        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>No skills found</h3>
        </div>
    }

</div>

<script>
    function filterSkills() {
        const query =
            document.getElementById("skillSearch")
                .value
                .toLowerCase()
                .trim();

        const items =
            document.getElementsByClassName("skill-item");

        for (let i = 0; i < items.length; i++) {
            const text =
                items[i].innerText.toLowerCase();

            items[i].classList.toggle(
                "hidden",
                !text.includes(query)
            );
        }
    }
</script>
