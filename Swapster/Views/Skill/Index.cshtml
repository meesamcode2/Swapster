@model IEnumerable<Swapster.Models.UserSkill>

@{
    ViewData["Title"] = "Available Matches & Skills";
    ViewData["BodyClass"] = "skills-page";
}

<style>
    /* Aapki pehle wali saari CSS same rahegi... */
    .skills-page {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f6f8ff;
        color: #111827;
    }

        .skills-page * {
            box-sizing: border-box;
        }

    .skills-wrapper {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(104, 124, 255, 0.18), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 100, 170, 0.15), transparent 35%), #f6f8ff;
        padding: 45px 7% 80px;
    }

    .skills-hero {
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        border-radius: 34px;
        padding: 42px;
        color: white;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        align-items: center;
        gap: 30px;
        box-shadow: 0 24px 55px rgba(102, 116, 255, 0.24);
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

        .skills-hero h1 {
            margin: 0;
            font-size: 48px;
            font-weight: 950;
            letter-spacing: -1.8px;
        }

        .skills-hero p {
            margin: 16px 0 0;
            max-width: 640px;
            line-height: 1.7;
            opacity: 0.94;
            font-size: 16px;
        }

    .skills-toolbar {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(18px);
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
    }

    .search-box {
        width: 100%;
        max-width: 460px;
        position: relative;
    }

        .search-box span {
            position: absolute;
            left: 17px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 18px;
        }

        .search-box input {
            width: 100%;
            height: 50px;
            border-radius: 18px;
            border: 1px solid #e5e7eb;
            padding: 12px 18px 12px 46px;
            outline: none;
            background: #f9fafb;
            color: #111827;
        }

    .add-skill-btn {
        text-decoration: none;
        border: none;
        background: linear-gradient(135deg, #6674ff, #ff64aa);
        color: white !important;
        padding: 13px 22px;
        border-radius: 35px;
        font-weight: 900;
        box-shadow: 0 12px 24px rgba(102, 116, 255, 0.25);
        white-space: nowrap;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .skill-card {
        height: 100%;
        background: white;
        border: 1px solid #eef0f7;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 35px rgba(35, 45, 90, 0.08);
        transition: 0.3s;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .skill-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 22px 45px rgba(102, 116, 255, 0.15);
        }

    .skill-title {
        font-size: 21px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 5px;
    }

    .skill-description {
        color: #6b7280;
        line-height: 1.65;
        margin-bottom: 12px;
        flex: 1;
    }

    .owner {
        font-size: 14px;
        color: #8a93a3;
        font-weight: 650;
        margin-bottom: 14px;
    }

    .request-btn {
        width: fit-content;
        text-decoration: none;
        background: #111827;
        color: white !important;
        padding: 10px 17px;
        border-radius: 35px;
        font-size: 14px;
        font-weight: 850;
    }

    .hidden {
        display: none !important;
    }

    /* --- NEW ADDITIONS FOR RATINGS & MATCHES --- */
    .rating-container {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stars {
        color: #ffb100;
        font-size: 16px;
        letter-spacing: 2px;
    }

    .rating-text {
        font-size: 12px;
        color: #6b7280;
        font-weight: 600;
        background: #f3f4f6;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .match-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }
</style>

<div class="skills-wrapper">

    <section class="skills-hero">
        <div class="skills-hero-content">
            <h1>Smart Skill Matches</h1>
            <p>
                Discover personalized skill-swap matches. We calculate compatibility based on what you want to learn and what others are offering!
            </p>
        </div>
    </section>

    <div class="skills-toolbar">
        <div class="search-box">
            <span>🔍</span>
            <input type="text" id="skillSearch" placeholder="Search skills by name..." onkeyup="filterSkills()" />
        </div>
        <a asp-action="Create" class="add-skill-btn">+ Add Your Skill</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="skills-grid" id="skillsGrid">
            @foreach (var item in Model)
            {
                <div class="skill-item">
                    <div class="skill-card">

                        <div class="match-badge">
                            ✨ Best Match
                        </div>

                        <div style="font-size: 32px; margin-bottom: 10px;">💡</div>

                        <div class="skill-title">@item.SkillName</div>

                        <div class="rating-container">
                            <span class="stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.ProficiencyLevel)
                                    {
                                        <text>★</text>
                                    }
                                    else
                                    {

                                        <text>☆</text>
                                    }
                                }
                            </span>
                            <span class="rating-text">Level @item.ProficiencyLevel/5</span>
                        </div>

                        <p class="skill-description">@item.Description</p>

                        <div class="owner">
                             Instructor: @(item.User?.Username ?? "Swapster User")
                        </div>

                        <a asp-controller="Request"
                           asp-action="Send"
                           asp-route-skillId="@item.SkillId"
                           asp-route-receiverId="@item.UserId"
                           class="request-btn">
                            Send Swap Request
                        </a>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state"><h3>No matches found</h3></div>
    }
</div>

<script>
    function filterSkills() {
        const query = document.getElementById("skillSearch").value.toLowerCase().trim();
        const items = document.getElementsByClassName("skill-item");
        for (let i = 0; i < items.length; i++) {
            const text = items[i].innerText.toLowerCase();
            items[i].classList.toggle("hidden", !text.includes(query));
        }
    }
</script>