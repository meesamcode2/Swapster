@model IEnumerable<Swapster.Models.SkillRequest>

@{
    ViewData["Title"] = "My Exchanges";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;

    int currentUserId =
        Context.Session.GetInt32("UserId") ?? 0;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background: #f4f6fb;
        color: #111827;
    }

    .page {
        max-width: 1100px;
        margin: auto;
        padding: 32px 20px 50px;
    }

    /* ================= HEADER ================= */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
        }

        .page-header p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

    .back-btn {
        text-decoration: none;
        background: #111827;
        color: white;
        padding: 10px 16px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 13px;
        transition: 0.2s;
    }

        .back-btn:hover {
            color: white;
            background: #1f2937;
            transform: translateY(-1px);
        }

    /* ================= ALERTS ================= */

    .alert-success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
        padding: 13px 16px;
        border-radius: 14px;
        margin-bottom: 16px;
        font-size: 13px;
        font-weight: 750;
    }

    .alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 13px 16px;
        border-radius: 14px;
        margin-bottom: 16px;
        font-size: 13px;
        font-weight: 750;
    }

    /* ================= EXCHANGE CARD ================= */

    .exchange-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 14px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
        transition: 0.2s;
    }

        .exchange-card:hover {
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.07);
        }

    .exchange-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .skill-name {
        font-size: 19px;
        font-weight: 900;
        margin-bottom: 7px;
    }

    .exchange-users {
        color: #6b7280;
        font-size: 13px;
        line-height: 1.7;
    }

    .request-direction {
        display: inline-block;
        margin-top: 7px;
        padding: 5px 9px;
        border-radius: 14px;
        background: #f3f4f6;
        color: #4b5563;
        font-size: 11px;
        font-weight: 750;
    }

    /* ================= STATUS ================= */

    .status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff7ed;
        color: #ea580c;
    }

    .status-active {
        background: #ecfdf5;
        color: #059669;
    }

    .status-rejected {
        background: #fef2f2;
        color: #dc2626;
    }

    .status-completed {
        background: #eef2ff;
        color: #4f46e5;
    }

    /* ================= ACTIONS ================= */

    .exchange-actions {
        margin-top: 17px;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .exchange-actions form {
            margin: 0;
        }

    .action-btn {
        border: none;
        text-decoration: none;
        padding: 9px 15px;
        border-radius: 20px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s;
    }

    .accept-btn {
        background: #16a34a;
        color: white;
    }

        .accept-btn:hover {
            background: #15803d;
            transform: translateY(-1px);
        }

    .reject-btn {
        background: #fee2e2;
        color: #dc2626;
    }

        .reject-btn:hover {
            background: #fecaca;
            color: #b91c1c;
            transform: translateY(-1px);
        }

    .message-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #111827;
        color: white;
    }

        .message-btn:hover {
            color: white;
            background: #1f2937;
            transform: translateY(-1px);
        }

    .complete-btn {
        background: #6674ff;
        color: white;
    }

        .complete-btn:hover {
            background: #5664ef;
            transform: translateY(-1px);
        }

    /* ================= CHIPS ================= */

    .confirmation-chip {
        display: inline-flex;
        align-items: center;
        padding: 9px 14px;
        border-radius: 20px;
        background: #ecfdf5;
        color: #059669;
        font-size: 12px;
        font-weight: 800;
    }

    .waiting-chip {
        display: inline-flex;
        align-items: center;
        padding: 9px 14px;
        border-radius: 20px;
        background: #fff7ed;
        color: #ea580c;
        font-size: 12px;
        font-weight: 800;
    }

    .rejected-note {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 14px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 12px;
        font-weight: 700;
    }

    .completed-note {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 14px;
        background: #eef2ff;
        color: #4338ca;
        font-size: 12px;
        font-weight: 700;
    }

    /* ================= EMPTY STATE ================= */

    .empty-state {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 40px;
        text-align: center;
        color: #6b7280;
    }

        .empty-state h3 {
            margin: 0 0 7px;
            color: #111827;
            font-size: 19px;
        }

        .empty-state p {
            margin: 0;
            font-size: 13px;
        }

    @@media (max-width: 700px) {

        .page {
            padding: 22px 15px 40px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .exchange-top {
            flex-direction: column;
        }

        .exchange-actions {
            align-items: stretch;
        }

            .exchange-actions form {
                width: 100%;
            }

        .action-btn,
        .message-btn {
            width: 100%;
            text-align: center;
        }

        .confirmation-chip,
        .waiting-chip {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="page-header">

        <div>
            <h1>My Exchanges</h1>

            <p>
                Track your pending, active and completed skill exchanges.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="back-btn">
            Back to Home
        </a>

    </div>

    <!-- ================= MESSAGES ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <!-- ================= EXCHANGE LIST ================= -->
    @if (Model != null && Model.Any())
    {
        foreach (var request in Model)
        {
            int otherUserId =
            request.SenderId == currentUserId
            ? request.ReceiverId
            : request.SenderId;

            string otherUsername =
            request.SenderId == currentUserId
            ? request.Receiver?.Username ?? "Unknown"
            : request.Sender?.Username ?? "Unknown";

            bool isSender =
            request.SenderId == currentUserId;

            bool isReceiver =
            request.ReceiverId == currentUserId;

            bool currentUserConfirmed =
            (isSender &&
            request.SenderConfirmedCompletion)
            ||
            (isReceiver &&
            request.ReceiverConfirmedCompletion);

            bool otherUserConfirmed =
            (isSender &&
            request.ReceiverConfirmedCompletion)
            ||
            (isReceiver &&
            request.SenderConfirmedCompletion);

            <div class="exchange-card">

                <!-- ================= TOP INFORMATION ================= -->

                <div class="exchange-top">

                    <div>

                        <div class="skill-name">
                            @(request.Skill?.SkillName ?? "Unknown Skill")
                        </div>

                        <div class="exchange-users">

                            Exchange with
                            <strong>@otherUsername</strong>

                            <br />

                            Requested:
                            @(request.CreatedAt.ToLocalTime()
                                                .ToString("dd MMM yyyy"))

                    <br />

                    @if (isSender)
                            {
                                <span class="request-direction">
                                    Request sent by you
                                </span>
                            }
                            else if (isReceiver)
                            {
                                <span class="request-direction">
                                    Request received from @otherUsername
                                </span>
                            }

                        </div>

                    </div>

                    <!-- ================= STATUS BADGE ================= -->

                    <div>

                        @if (request.Status == "Completed")
                        {
                            <span class="status status-completed">
                                Completed
                            </span>
                        }
                        else if (request.Status == "Accepted")
                        {
                            <span class="status status-active">
                                Active
                            </span>
                        }
                        else if (request.Status == "Rejected")
                        {
                            <span class="status status-rejected">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="status status-pending">
                                Pending
                            </span>
                        }

                    </div>

                </div>

                <!-- ================= PENDING REQUEST ================= -->
                @if (request.Status == "Pending")
                {
                    <div class="exchange-actions">

                        @if (isReceiver)
                        {
                            <!-- RECEIVER CAN ACCEPT -->

                            <form asp-controller="SkillRequest"
                                  asp-action="Accept"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@request.Id" />

                                <button type="submit"
                                        class="action-btn accept-btn">
                                         Accept
                                </button>

                            </form>

                            <!-- RECEIVER CAN REJECT -->

                            <form asp-controller="SkillRequest"
                                  asp-action="Reject"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@request.Id" />

                                <button type="submit"
                                        class="action-btn reject-btn">
                                    Reject
                                </button>

                            </form>
                        }
                        else if (isSender)
                        {
                            <!-- SENDER ONLY WAITS -->

                            <span class="waiting-chip">
                                Waiting for @otherUsername to respond
                            </span>
                        }

                    </div>
                }

                <!-- ================= ACCEPTED / ACTIVE ================= -->
                @if (request.Status == "Accepted")
                {
                    <div class="exchange-actions">

                        <a asp-controller="Chat"
                           asp-action="Conversation"
                           asp-route-userId="@otherUserId"
                           class="action-btn message-btn">
                            Message
                        </a>

                        @if (!currentUserConfirmed)
                        {
                            <form asp-controller="SkillRequest"
                                  asp-action="Complete"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@request.Id" />

                                <button type="submit"
                                        class="action-btn complete-btn">
                                    Confirm Completion
                                </button>

                            </form>
                        }
                        else
                        {
                            <span class="confirmation-chip">
                                You confirmed completion
                            </span>
                        }

                        @if (currentUserConfirmed &&
                                    !otherUserConfirmed)
                        {
                            <span class="waiting-chip">
                                Waiting for @otherUsername to confirm
                            </span>
                        }

                        @if (!currentUserConfirmed &&
                                    otherUserConfirmed)
                        {
                            <span class="waiting-chip">
                                @otherUsername has already confirmed
                            </span>
                        }

                    </div>
                }

                <!-- ================= REJECTED ================= -->
                @if (request.Status == "Rejected")
                {
                    <div class="rejected-note">
                        This skill exchange request was rejected.
                    </div>
                }

                <!-- ================= COMPLETED ================= -->
                @if (request.Status == "Completed")
                {
                    <div class="completed-note">
                        Both users confirmed this skill exchange as completed.
                    </div>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-state">

            <h3>No exchanges yet</h3>

            <p>
                Send a skill swap request to another user to begin an exchange.
            </p>

        </div>
    }

</div>